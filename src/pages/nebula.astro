---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const friends = site.friends || [];
const ringRadius = 140;

const friendStars = friends.map((f, i) => {
  const angle = (2 * Math.PI * i) / friends.length - Math.PI / 2;
  return {
    ...f,
    x: ringRadius * Math.cos(angle),
    y: ringRadius * Math.sin(angle),
    delay: i * 0.3,
  };
});
---

<BaseLayout title="Nebula — Friendly Stars" description="A constellation of friendly sites in the blogosphere">
  <div class="container" style="padding-top:40px;padding-bottom:40px">
    <a href="/" class="back-link">← Star map</a>

    <header style="margin:24px 0 32px;text-align:center">
      <h1 style="font-family:var(--font-display);font-size:var(--text-2xl);color:var(--star-gold);letter-spacing:0.06em;margin-bottom:8px">
        🌌 The Nebula
      </h1>
      <p style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--text-dim);max-width:500px;margin:0 auto">
        Friendly stars in the cosmic web. Each is a gateway to another world of thought.
        If you'd like your star to appear here, send a signal through GitHub.
      </p>
    </header>

    <div class="nebula-canvas">
      <div class="nebula-ring">
        {/* Central star */}
        <div class="nebula-core">{site.author}</div>

        {/* Friend stars */}
        {friendStars.map((f, i) => (
          <a
            href={f.url}
            target="_blank"
            rel="noopener"
            class="nebula-friend"
            style={`transform:translate(calc(-50% + ${f.x}px),calc(-50% + ${f.y}px));animation:nebulaOrbitAppear 0.6s ease-out ${f.delay}s both`}
            title={f.desc}
          >
            <div class="nebula-friend-dot"></div>
            <span class="nebula-friend-name">{f.name}</span>
            <span class="nebula-friend-desc">{f.desc}</span>
          </a>
        ))}

        {friends.length === 0 && (
          <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;font-family:var(--font-display);font-size:var(--text-sm);color:var(--text-muted)">
            No neighboring stars yet.<br/>Check back as the nebula expands.
          </div>
        )}
      </div>
    </div>

    {/* Add to nebula CTA */}
    <div style="text-align:center;margin-top:40px;padding:24px;background:var(--surface);border:1px solid var(--border);border-radius:8px">
      <p style="font-family:var(--font-body);font-size:var(--text-sm);color:var(--text-dim);margin-bottom:12px">
        Want your star in this nebula?
      </p>
      <a
        href={`https://github.com/brucescan/brucescan.github.io/edit/master/src/data/site.ts`}
        style="font-family:var(--font-display);font-size:var(--text-xs);color:var(--star-gold);letter-spacing:0.06em;padding:8px 24px;border:1px solid var(--star-gold);border-radius:6px;display:inline-block;text-decoration:none;transition:all 0.3s"
      >
        ✦ Submit a Pull Request
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .back-link{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:var(--text-xs);color:var(--text-muted);text-decoration:none;transition:color 0.3s}
  .back-link:hover{color:var(--star-gold);text-shadow:none}
  @keyframes nebulaOrbitAppear{from{opacity:0;transform:translate(calc(-50% + 0px),calc(-50% + 0px)) scale(0)}to{opacity:1}}
</style>
