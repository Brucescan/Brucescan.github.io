---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tagSet = new Set<string>();
  for (const post of posts) for (const tag of post.data.tags) tagSet.add(tag);
  return Array.from(tagSet).map(tag => ({ params: { tag: tag.toLowerCase() }, props: { tagName: tag } }));
}

const { tagName } = Astro.props;
const allPosts = await getCollection("blog");
const published = allPosts.filter(p => !p.data.draft);
const filtered = published
  .filter(p => p.data.tags.some(t => t.toLowerCase() === tagName.toLowerCase()))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// All tags for sidebar
const tagMap = new Map<string,number>();
for (const post of published) for (const tag of post.data.tags) tagMap.set(tag,(tagMap.get(tag)||0)+1);
const allTags = Array.from(tagMap.entries()).map(([n,c])=>({name:n,count:c})).sort((a,b)=>b.count-a.count);

// ── Constellation SVG data ──
const cx=200, cy=200, radius=130;
const constellationStars = filtered.map((p, i) => {
  const angle = (2*Math.PI*i)/filtered.length - Math.PI/2;
  return { id: p.id, title: p.data.title, x: cx + radius*Math.cos(angle), y: cy + radius*Math.sin(angle) };
});
// Generate constellation lines (connect adjacent in a pattern)
function constellationLines(stars: typeof constellationStars): [number,number,number,number][] {
  if (stars.length < 2) return [];
  const lines: [number,number,number,number][] = [];
  for (let i=0;i<stars.length-1;i++) lines.push([stars[i].x,stars[i].y,stars[i+1].x,stars[i+1].y]);
  if (stars.length >= 3) lines.push([stars[0].x,stars[0].y,stars[stars.length-1].x,stars[stars.length-1].y]); // close loop
  // Extra diagonals for 5+ stars
  if (stars.length >= 5) {
    for (let i=0;i<stars.length;i++) {
      const j=(i+2)%stars.length;
      if (i<j) lines.push([stars[i].x,stars[i].y,stars[j].x,stars[j].y]);
    }
  }
  return lines;
}
const clines = constellationLines(constellationStars);
---

<BaseLayout title={`${tagName} — Constellation`} description={`Articles tagged ${tagName}`}>
  <div class="container" style="padding-top:40px;padding-bottom:40px">
    <a href="/" class="back-link">← Star map</a>

    <header style="margin:24px 0 32px">
      <h1 style="font-family:var(--font-display);font-size:var(--text-2xl);color:var(--star-gold);letter-spacing:0.06em;margin-bottom:8px">
        ✦ Constellation: {tagName}
      </h1>
      <p style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--text-dim)">
        {filtered.length} star{filtered.length!==1?'s':''} in this constellation
      </p>
    </header>

    {/* Constellation diagram */}
    {filtered.length >= 2 && (
      <div style="display:flex;justify-content:center;margin-bottom:32px">
        <svg width="400" height="280" viewBox="0 0 400 400" style="max-width:100%;height:auto" aria-hidden="true">
          {/* Background glow */}
          <circle cx={cx} cy={cy} r={radius+30} fill="none" stroke="rgba(255,208,102,0.05)" stroke-width="40"/>
          {/* Constellation lines */}
          {clines.map(([x1,y1,x2,y2]) => (
            <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="rgba(255,208,102,0.2)" stroke-width="1.5" stroke-dasharray="4 3">
              <animate attributeName="stroke-opacity" values="0.15;0.35;0.15" dur="3s" repeatCount="indefinite"/>
            </line>
          ))}
          {/* Stars */}
          {constellationStars.map((s, i) => (
            <g>
              <circle cx={s.x} cy={s.y} r="6" fill="var(--star-gold)" opacity="0.2">
                <animate attributeName="r" values="6;12;6" dur="2s" begin={`${i*0.3}s`} repeatCount="indefinite"/>
                <animate attributeName="opacity" values="0.15;0.4;0.15" dur="2s" begin={`${i*0.3}s`} repeatCount="indefinite"/>
              </circle>
              <circle cx={s.x} cy={s.y} r="3" fill="var(--star-gold)" style="filter:drop-shadow(0 0 6px var(--star-glow))"/>
              <text x={s.x} y={s.y-12} text-anchor="middle" fill="var(--text-muted)" font-family="var(--font-mono)" font-size="6">{s.title.slice(0,12)}</text>
            </g>
          ))}
        </svg>
      </div>
    )}

    <!-- All constellations -->
    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:32px;align-items:center">
      <span style="font-family:var(--font-mono);font-size:var(--text-2xs);color:var(--text-muted);margin-right:4px">Navigate:</span>
      {allTags.map(t => (
        <a
          href={`/tags/${t.name.toLowerCase()}`}
          style={`font-family:var(--font-display);font-size:0.55rem;letter-spacing:0.04em;padding:3px 12px;border-radius:10px;text-decoration:none;transition:all 0.3s;${t.name===tagName?'background:rgba(255,208,102,0.15);border-color:var(--star-gold);color:var(--star-gold);border:1px solid var(--star-gold);box-shadow:0 0 12px var(--star-glow)':'color:var(--text-dim);border:1px solid var(--border)'}`}
        >
          {t.name} ({t.count})
        </a>
      ))}
    </div>

    <!-- Article list -->
    <div style="display:flex;flex-direction:column;gap:8px">
      {filtered.map(p => (
        <a
          href={`/blog/${p.id}`}
          style="display:flex;align-items:baseline;gap:20px;padding:14px 18px;background:var(--surface);border:1px solid var(--border);border-radius:6px;text-decoration:none;transition:all 0.3s"
        >
          <span style="font-family:var(--font-mono);font-size:var(--text-2xs);color:var(--text-muted);white-space:nowrap;flex-shrink:0">
            {p.data.date.toLocaleDateString("zh-CN",{month:"short",day:"numeric"})}
          </span>
          <div style="flex:1;min-width:0">
            <div style="font-family:var(--font-display);font-size:var(--text-sm);color:var(--star-gold);margin-bottom:2px">{p.data.title}</div>
            <div style="font-size:var(--text-xs);color:var(--text-dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{p.data.description}</div>
          </div>
          {p.data.tags.filter(t=>t!==tagName).slice(0,2).map(t=>(
            <span style="font-family:var(--font-display);font-size:0.5rem;color:var(--text-muted);padding:2px 8px;border:1px solid var(--border);border-radius:6px;flex-shrink:0">{t}</span>
          ))}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .back-link{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:var(--text-xs);color:var(--text-muted);text-decoration:none;transition:color 0.3s}
  .back-link:hover{color:var(--star-gold);text-shadow:none}
</style>
