---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tagSet = new Set<string>();
  for (const post of posts) for (const tag of post.data.tags) tagSet.add(tag);
  return Array.from(tagSet).map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: { tagName: tag },
  }));
}

const { tagName } = Astro.props;
const allPosts = await getCollection("blog");
const filtered = allPosts
  .filter((p) => p.data.tags.some((t) => t.toLowerCase() === tagName.toLowerCase()))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// All tags for sidebar
const tagMap = new Map<string, number>();
for (const post of allPosts)
  for (const tag of post.data.tags)
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
const allTags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title={`${tagName} — Spell School`}
  appName={`School: ${tagName}`}
  appIcon="📁"
>
  <div class="program">
    <div class="program-titlebar">
      <span class="program-title">📁 FILE BROWSER — {tagName}\ ({filtered.length} items)</span>
      <a href="/" class="program-menu" title="Desktop">◀ Desktop</a>
    </div>

    <div class="program-body">
      <!-- Other schools -->
      <div style="margin-bottom:16px;display:flex;flex-wrap:wrap;gap:6px;align-items:center">
        <span style="font-family:var(--font-ui);font-size:0.65rem;color:var(--text-dim)">Schools:</span>
        {allTags.map((t) => (
          <a
            href={`/tags/${t.name.toLowerCase()}`}
            style={`font-family:var(--font-ui);font-size:0.6rem;padding:4px 10px;text-decoration:none;color:var(--text);${t.name === tagName ? 'background:var(--title-active);color:#fff;' : 'background:var(--face);'}box-shadow:inset 1px 1px 0 var(--highlight),inset -1px -1px 0 var(--shadow)`}
          >
            {t.name} ({t.count})
          </a>
        ))}
      </div>

      <!-- File list -->
      <div style="border:1px solid var(--shadow);box-shadow:inset 1px 1px 0 var(--shadow)">
        <div style="display:flex;background:var(--face);padding:4px 8px;font-family:var(--font-ui);font-size:0.65rem;box-shadow:inset 0 -1px 0 var(--shadow)">
          <span style="width:30px">📄</span>
          <span style="flex:1">Name</span>
          <span style="width:100px;text-align:right">Date</span>
        </div>
        {filtered.map((p) => (
          <a
            href={`/blog/${p.id}`}
            style="display:flex;padding:4px 8px;text-decoration:none;color:var(--text);border-bottom:1px solid var(--shadow);font-size:0.85rem;align-items:center"
            onmouseover="this.style.background='var(--title-active)';this.style.color='#fff'"
            onmouseout="this.style.background='';this.style.color=''"
          >
            <span style="width:30px">📝</span>
            <span style="flex:1">{p.data.title}</span>
            <span style="width:100px;text-align:right;font-size:0.75rem;color:var(--text-dim)">{p.data.date.toLocaleDateString("zh-CN", { month: "short", day: "numeric" })}</span>
          </a>
        ))}
      </div>

      <div style="margin-top:8px;font-family:var(--font-ui);font-size:0.65rem;color:var(--text-dim)">
        {filtered.length} scroll{filtered.length !== 1 ? 's' : ''} found. <a href="/">← Return to Desktop</a>
      </div>
    </div>
  </div>
</BaseLayout>
