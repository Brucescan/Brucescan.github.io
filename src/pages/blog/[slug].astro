---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { id: post.id },
  }));
}

const { id } = Astro.props;
const post = await getEntry("blog", id);

if (!post) {
  return Astro.redirect("/");
}

const { Content } = await render(post);

// Related posts: same tags, excluding current
const allPosts = await getCollection("blog");
const relatedPosts = allPosts
  .filter((p) => p.id !== id && p.data.tags.some((t) => post.data.tags.includes(t)))
  .slice(0, 2);

const formattedDate = post.data.date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const pageUrl = `https://brucescan.github.io/blog/${id}`;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <header class="post-header container">
      <a href="/#posts" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 4L6 8L10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to all posts
      </a>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        {post.data.readingTime && (
          <>
            <span class="dot">·</span>
            <span>{post.data.readingTime}</span>
          </>
        )}
        {post.data.tags && post.data.tags.length > 0 && (
          <>
            <span class="dot">·</span>
            <span class="post-header-tags">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${tag.toLowerCase()}`} class="post-header-tag">{tag}</a>
              ))}
            </span>
          </>
        )}
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
    </header>

    <div class="post-layout container">
      <aside class="post-toc-sidebar" aria-label="Table of Contents">
        <nav class="toc" id="toc">
          <div class="toc-title">On this page</div>
          <ul class="toc-list" id="tocList"></ul>
        </nav>
      </aside>

      <div class="post-body" id="postBody">
        <Content />

        <div class="share-section">
          <div class="share-title">Share this post</div>
          <div class="share-buttons">
            <button class="share-btn" id="copyLinkBtn" aria-label="Copy link">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M10 4H4a2 2 0 00-2 2v6a2 2 0 002 2h6a2 2 0 002-2v-1M6 12l8-8M10 5l2-1 1 2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>

        {
          relatedPosts.length > 0 && (
            <div class="related-posts">
              <h3 class="related-title">Related posts</h3>
              <div class="related-grid">
                {relatedPosts.map((rp) => (
                  <a href={`/blog/${rp.id}`} class="related-card">
                    <div class="related-card-title">{rp.data.title}</div>
                    <div class="related-card-date">
                      {rp.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </article>

  <script>
    document.getElementById("copyLinkBtn")?.addEventListener("click", function() {
      navigator.clipboard.writeText(window.location.href).then(function() {
        var btn = document.getElementById("copyLinkBtn");
        btn.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8l3.5 3.5L13 5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        btn.style.color = "#30d158";
        setTimeout(function() {
          btn.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 4H4a2 2 0 00-2 2v6a2 2 0 002 2h6a2 2 0 002-2v-1M6 12l8-8M10 5l2-1 1 2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
          btn.style.color = "";
        }, 2000);
      });
    });
  </script>

  <script>
    // --- Build TOC from article headings ---
    (function() {
      const postBody = document.getElementById("postBody");
      const tocList = document.getElementById("tocList");
      const toc = document.getElementById("toc");
      if (!postBody || !tocList) return;

      const headings = postBody.querySelectorAll("h2, h3");
      if (headings.length === 0) {
        toc?.remove();
        return;
      }

      const tocItems = [];

      headings.forEach((h, i) => {
        // Add id for anchor linking
        const id = `heading-${i}`;
        h.id = id;

        const item = document.createElement("li");
        item.className = "toc-item";
        item.style.paddingLeft = h.tagName === "H3" ? "var(--space-xl)" : "var(--space-md)";

        const link = document.createElement("a");
        link.className = "toc-link";
        link.href = `#${id}`;
        link.textContent = h.textContent;
        link.addEventListener("click", (e) => {
          e.preventDefault();
          h.scrollIntoView({ behavior: "smooth", block: "start" });
          history.pushState(null, "", `#${id}`);
        });

        item.appendChild(link);
        tocList.appendChild(item);
        tocItems.push({ item, id });
      });

      // --- Highlight current section on scroll ---
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const idx = tocItems.findIndex((t) => t.id === entry.target.id);
            if (idx !== -1 && entry.isIntersecting) {
              tocItems.forEach((t) => t.item.classList.remove("active"));
              tocItems[idx].item.classList.add("active");
            }
          });
        },
        { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
      );

      headings.forEach((h) => observer.observe(h));
    })();
  </script>
</BaseLayout>

<style>
  .post {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }

  .post-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-xl);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }

  .dot {
    color: var(--color-text-tertiary);
  }

  .post-header-tags {
    display: inline-flex;
    gap: 6px;
  }

  .post-header-tag {
    display: inline-block;
    padding: 1px 8px;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    background: var(--color-code-bg);
    border-radius: 980px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .post-header-tag:hover {
    color: var(--color-text);
    background: var(--color-border);
  }

  .post-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: var(--space-md);
  }

  .post-desc {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 600px;
  }

  /* Two-column layout */
  .post-layout {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .post-toc-sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-xl));
  }

  .post-body {
    min-width: 0;
  }

  .post-body :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .post-body :global(h3) {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .post-body :global(p) {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-text);
    opacity: 0.9;
    margin-bottom: var(--space-lg);
  }

  .post-body :global(strong) {
    font-weight: 600;
    opacity: 1;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-xl);
  }

  .post-body :global(li) {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-text);
    opacity: 0.9;
    margin-bottom: var(--space-xs);
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-code-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .post-body :global(pre) {
    background: var(--color-code-block);
    color: var(--color-code-block-text);
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    line-height: 1.6;
    border: 1px solid var(--color-border);
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
    border: none;
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-lg);
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .post-body :global(blockquote p) {
    color: inherit;
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-2xl) 0;
  }

  .post-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 1024px) {
    .post-layout {
      grid-template-columns: 1fr;
    }

    .post-toc-sidebar {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: var(--text-2xl);
    }

    .post-body :global(p),
    .post-body :global(li) {
      font-size: var(--text-base);
    }
  }
</style>
