---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { id: post.id },
  }));
}

const { id } = Astro.props;
const post = await getEntry("blog", id);

if (!post) {
  return Astro.redirect("/");
}

const { Content } = await render(post);

// Auto-calculate reading time
const bodyText = post.body || "";
const chineseChars = (bodyText.match(/[一-鿿]/g) || []).length;
const englishWords = (bodyText.match(/[a-zA-Z]+/g) || []).length;
const readingMinutes = Math.max(1, Math.ceil(Math.max(chineseChars / 400, englishWords / 200)));
const readingTime = `${readingMinutes} min read`;

// Related posts: same tags, excluding current
const allPosts = await getCollection("blog");
const relatedPosts = allPosts
  .filter((p) => p.id !== id && p.data.tags.some((t) => post.data.tags.includes(t)))
  .slice(0, 2);

const formattedDate = post.data.date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Prev / next navigation
const sortedPosts = allPosts
  .filter((p) => p.id !== id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .findIndex((p) => p.id === id);
const prevPost = currentIndex > 0
  ? allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[currentIndex - 1]
  : null;
const nextPost = currentIndex < allPosts.length - 1
  ? allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[currentIndex + 1]
  : null;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <header class="post-header container">
      <a href="/#posts" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 4L6 8L10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to all posts
      </a>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        <span class="dot">·</span>
        <span>{readingTime}</span>
        {post.data.tags && post.data.tags.length > 0 && (
          <>
            <span class="dot">·</span>
            <span class="post-header-tags">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${tag.toLowerCase()}`} class="post-header-tag lggc">{tag}</a>
              ))}
            </span>
          </>
        )}
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
    </header>

    <div class="post-layout container">
      <aside class="post-toc-sidebar" aria-label="Table of Contents">
        <nav class="toc" id="toc">
          <div class="toc-title">On this page</div>
          <ul class="toc-list" id="tocList"></ul>
        </nav>
      </aside>

      <div class="post-body" id="postBody">
        <div class="reading-countdown" id="readingCountdown">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="6" cy="6" r="4.5"/><path d="M6 3.5V6L8 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span id="readingTimeLeft">~{readingMinutes} min read</span>
        </div>
        <Content />

        <div class="share-section">
          <div class="share-title">Share this post</div>
          <div class="share-buttons">
            <button class="share-btn lggc" id="copyLinkBtn" aria-label="Copy link">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M10 4H4a2 2 0 00-2 2v6a2 2 0 002 2h6a2 2 0 002-2v-1M6 12l8-8M10 5l2-1 1 2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>

        {
          relatedPosts.length > 0 && (
            <div class="related-posts">
              <h3 class="related-title">Related posts</h3>
              <div class="related-grid">
                {relatedPosts.map((rp) => (
                  <a href={`/blog/${rp.id}`} class="related-card">
                    <div class="related-card-title">{rp.data.title}</div>
                    <div class="related-card-date">
                      {rp.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <!-- Prev / Next navigation -->
        <nav class="post-nav" aria-label="Adjacent articles">
          {prevPost ? (
            <a href={`/blog/${prevPost.id}`} class="post-nav-link prev">
              <span class="post-nav-label">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M7 2L3 6L7 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Previous
              </span>
              <span class="post-nav-title">{prevPost.data.title}</span>
            </a>
          ) : <span class="post-nav-link prev empty" />}

          {nextPost ? (
            <a href={`/blog/${nextPost.id}`} class="post-nav-link next">
              <span class="post-nav-label">
                Next
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M5 2L9 6L5 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="post-nav-title">{nextPost.data.title}</span>
            </a>
          ) : <span class="post-nav-link next empty" />}
        </nav>
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.date.toISOString(),
    "author": { "@type": "Person", "name": site.author },
    "url": pageUrl,
  })}>
  </script>

  <script>
    // Reading countdown
    (function() {
      var el = document.getElementById("readingTimeLeft");
      var countdown = document.getElementById("readingCountdown");
      if (!el || !countdown) return;
      var totalMin = parseInt(el.textContent) || 5;
      el.textContent = "~" + totalMin + " min left";

      window.addEventListener("scroll", function() {
        var h = document.documentElement.scrollHeight - window.innerHeight;
        var pct = h > 0 ? window.scrollY / h : 0;
        var remaining = Math.max(1, Math.round(totalMin * (1 - pct)));
        el.textContent = "~" + remaining + " min left";
        if (pct > 0.95) countdown.classList.add("done");
        else countdown.classList.remove("done");
      }, { passive: true });
    })();

    document.getElementById("copyLinkBtn")?.addEventListener("click", function() {
      navigator.clipboard.writeText(window.location.href).then(function() {
        var btn = document.getElementById("copyLinkBtn");
        btn.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8l3.5 3.5L13 5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        btn.style.color = "#30d158";
        setTimeout(function() {
          btn.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 4H4a2 2 0 00-2 2v6a2 2 0 002 2h6a2 2 0 002-2v-1M6 12l8-8M10 5l2-1 1 2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
          btn.style.color = "";
        }, 2000);
      });
    });
  </script>

  <script>
    // --- Build TOC from article headings ---
    (function() {
      const postBody = document.getElementById("postBody");
      const tocList = document.getElementById("tocList");
      const toc = document.getElementById("toc");
      if (!postBody || !tocList) return;

      const headings = postBody.querySelectorAll("h2, h3");
      if (headings.length === 0) {
        toc?.remove();
        return;
      }

      const tocItems = [];

      headings.forEach((h, i) => {
        // Add id for anchor linking
        const id = `heading-${i}`;
        h.id = id;

        const item = document.createElement("li");
        item.className = "toc-item";
        item.style.paddingLeft = h.tagName === "H3" ? "var(--space-xl)" : "var(--space-md)";

        const link = document.createElement("a");
        link.className = "toc-link";
        link.href = `#${id}`;
        link.textContent = h.textContent;
        link.addEventListener("click", (e) => {
          e.preventDefault();
          h.scrollIntoView({ behavior: "smooth", block: "start" });
          history.pushState(null, "", `#${id}`);
        });

        item.appendChild(link);
        tocList.appendChild(item);
        tocItems.push({ item, id });
      });

      // --- Highlight current section on scroll ---
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const idx = tocItems.findIndex((t) => t.id === entry.target.id);
            if (idx !== -1 && entry.isIntersecting) {
              tocItems.forEach((t) => t.item.classList.remove("active"));
              tocItems[idx].item.classList.add("active");
            }
          });
        },
        { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
      );

      headings.forEach((h) => observer.observe(h));

      // --- Wrap tables for responsive scroll ---
      postBody.querySelectorAll("table").forEach(function(table) {
        if (!table.parentElement.classList.contains("table-wrapper")) {
          var wrapper = document.createElement("div");
          wrapper.className = "table-wrapper";
          table.parentNode.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .post {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }

  .post-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-xl);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }

  .dot {
    color: var(--color-text-tertiary);
  }

  .post-header-tags {
    display: inline-flex;
    gap: 6px;
  }

  .post-header-tag {
    --lggc-padding: 2px 10px;
    --lggc-radius: 980px;
    --lggc-blur: 3px;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-decoration: none;
    min-width: auto;
    min-height: auto;
  }

  .post-header-tag:hover {
    color: var(--color-text);
  }

  .post-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: var(--space-md);
  }

  .post-desc {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 600px;
  }

  /* Two-column layout */
  .post-layout {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .post-toc-sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-xl));
  }

  .post-body {
    min-width: 0;
  }

  .post-body :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .post-body :global(h3) {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .post-body :global(p) {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-text);
    opacity: 0.9;
    margin-bottom: var(--space-lg);
  }

  .post-body :global(strong) {
    font-weight: 600;
    opacity: 1;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-xl);
  }

  .post-body :global(li) {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-text);
    opacity: 0.9;
    margin-bottom: var(--space-xs);
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-code-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .post-body :global(pre) {
    background: var(--color-code-block);
    color: var(--color-code-block-text);
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    line-height: 1.6;
    border: 1px solid var(--color-border);
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
    border: none;
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-lg);
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .post-body :global(blockquote p) {
    color: inherit;
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-2xl) 0;
  }

  .post-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 1024px) {
    .post-layout {
      grid-template-columns: 1fr;
    }

    .post-toc-sidebar {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: var(--text-2xl);
    }

    .post-body :global(p),
    .post-body :global(li) {
      font-size: var(--text-base);
    }
  }

  /* ── Prev / Next navigation ── */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    background: rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  [data-theme="dark"] .post-nav-link {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .post-nav-link:hover {
    background: rgba(255, 255, 255, 0.65);
    border-color: rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  [data-theme="dark"] .post-nav-link:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .post-nav-link.next {
    text-align: right;
    align-items: flex-end;
  }

  .post-nav-link.empty {
    visibility: hidden;
  }

  .post-nav-label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
  }

  .post-nav-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Reading countdown ── */
  .reading-countdown {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px) saturate(160%);
    -webkit-backdrop-filter: blur(8px) saturate(160%);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 980px;
    position: sticky;
    top: calc(var(--header-height) + var(--space-md));
    float: right;
    margin-left: var(--space-lg);
    margin-bottom: var(--space-md);
    z-index: 5;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  [data-theme="dark"] .reading-countdown {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .reading-countdown.done {
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav-link.next {
      text-align: left;
      align-items: flex-start;
    }

    .reading-countdown {
      float: none;
      display: flex;
      justify-content: center;
      margin: var(--space-md) 0;
    }
  }
</style>
