---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { id: post.id },
  }));
}

const { id } = Astro.props;
const post = await getEntry("blog", id);

if (!post) {
  return Astro.redirect("/");
}

const { Content } = await render(post);

const bodyText = post.body || "";
const chineseChars = (bodyText.match(/[一-鿿]/g) || []).length;
const englishWords = (bodyText.match(/[a-zA-Z]+/g) || []).length;
const readingMinutes = Math.max(1, Math.ceil(Math.max(chineseChars / 400, englishWords / 200)));

const allPosts = await getCollection("blog");
const formattedDate = post.data.date.toLocaleDateString("zh-CN", {
  year: "numeric", month: "long", day: "numeric",
});

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const sortedAll = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = sortedAll.findIndex((p) => p.id === id);
const prevPost = currentIndex > 0 ? sortedAll[currentIndex - 1] : null;
const nextPost = currentIndex < sortedAll.length - 1 ? sortedAll[currentIndex + 1] : null;
---

<BaseLayout title={post.data.title} description={post.data.description} autoOpen={`article-${id}`}>
  <!-- Desktop icon to return to this article -->
  <Fragment slot="icons">
    <div class="desk-icon" data-action="open-window" data-target="questlog" title="Quest Log — Browse all articles">
      <div class="desk-icon-sprite">📖</div>
      <div class="desk-icon-label">Quest Log</div>
    </div>
    <div class="desk-icon" data-action="open-window" data-target="tags" title="Spell Schools">
      <div class="desk-icon-sprite">📁</div>
      <div class="desk-icon-label">Spell Schools</div>
    </div>
    <div class="desk-icon" data-action="open-window" data-target="about" title="README.txt">
      <div class="desk-icon-sprite">ℹ️</div>
      <div class="desk-icon-label">README.txt</div>
    </div>
  </Fragment>

  <!-- SEO: Full article content visible to search engines -->
  <div id="seo-content" style="display:none" aria-hidden="true">
    <article>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
      <Content />
    </article>
  </div>

  <!-- Pass full article HTML as a template for the window -->
  <div id="article-full-content" style="display:none">
    <div style="padding:8px">
      <div style="margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--win-shadow);font-size:var(--text-xs);color:var(--text-secondary)">
        📅 {formattedDate} &nbsp;·&nbsp; ⏱ ~{readingMinutes} min read &nbsp;·&nbsp;
        {post.data.tags.map(tag => (
          <a href={`/tags/${tag.toLowerCase()}`} style="margin:0 2px;color:var(--accent-blue)">#{tag}</a>
        ))}
      </div>
      <Content />
      <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--win-shadow);display:flex;justify-content:space-between;align-items:center">
        {prevPost ? (
          <a href={`/blog/${prevPost.id}`} style="font-size:var(--text-xs);color:var(--accent-blue)">◀ {prevPost.data.title}</a>
        ) : <span></span>}
        {nextPost ? (
          <a href={`/blog/${nextPost.id}`} style="font-size:var(--text-xs);color:var(--accent-blue)">{nextPost.data.title} ▶</a>
        ) : <span></span>}
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.date.toISOString(),
    "author": { "@type": "Person", "name": site.author },
    "url": pageUrl,
  })}>
  </script>

  <!-- Register article content for window manager -->
  <script set:html={`window._articleHTML_${id} = document.getElementById('article-full-content')?.innerHTML || '';`}></script>
</BaseLayout>
