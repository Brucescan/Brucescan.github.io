---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { id: post.id },
  }));
}

const { id } = Astro.props;
const post = await getEntry("blog", id);

if (!post) {
  return Astro.redirect("/");
}

const { Content } = await render(post);

const bodyText = post.body || "";
const chineseChars = (bodyText.match(/[一-鿿]/g) || []).length;
const englishWords = (bodyText.match(/[a-zA-Z]+/g) || []).length;
const readingMinutes = Math.max(1, Math.ceil(Math.max(chineseChars / 400, englishWords / 200)));

const formattedDate = post.data.date.toLocaleDateString("zh-CN", {
  year: "numeric", month: "long", day: "numeric",
});

const allPosts = await getCollection("blog");
const sortedAll = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = sortedAll.findIndex((p) => p.id === id);
const prevPost = currentIndex > 0 ? sortedAll[currentIndex - 1] : null;
const nextPost = currentIndex < sortedAll.length - 1 ? sortedAll[currentIndex + 1] : null;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Get sibling articles for quick nav
const siblings = sortedAll.filter(p => p.id !== id).slice(0, 5);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  appName={`Scroll: ${post.data.title}`}
  appIcon="📜"
>
  <div class="program">
    <!-- Menu bar -->
    <div class="program-titlebar">
      <span class="program-title">📜 SCROLL READER — {post.data.title}</span>
      <a href="/" class="program-menu" title="Back to Desktop">◀ Desktop</a>
    </div>

    <div class="program-body">
      <!-- Article metadata bar -->
      <div class="article-meta">
        <span>📅 {formattedDate}</span>
        <span>·</span>
        <span>⏱ ~{readingMinutes} min</span>
        {post.data.tags.length > 0 && (
          <>
            <span>·</span>
            {post.data.tags.map((tag) => (
              <a href={`/tags/${tag.toLowerCase()}`}>#{tag}</a>
            ))}
          </>
        )}
      </div>

      <!-- Article content -->
      <Content />

      <!-- Prev / Next navigation -->
      <nav class="article-nav">
        {prevPost ? (
          <a href={`/blog/${prevPost.id}`}>◀ Previous: {prevPost.data.title}</a>
        ) : <span></span>}
        {nextPost ? (
          <a href={`/blog/${nextPost.id}`}>Next: {nextPost.data.title} ▶</a>
        ) : <span></span>}
      </nav>

      <!-- More scrolls -->
      {siblings.length > 0 && (
        <div style="margin-top:20px;padding-top:12px;border-top:2px solid var(--shadow)">
          <p style="font-family:var(--font-ui);font-size:0.7rem;color:var(--text-dim);margin-bottom:8px">MORE SCROLLS:</p>
          <div style="display:flex;flex-wrap:wrap;gap:6px">
            {siblings.map((s) => (
              <a href={`/blog/${s.id}`} style="font-family:var(--font-ui);font-size:0.6rem;padding:4px 10px;background:var(--face);text-decoration:none;color:var(--text);box-shadow:inset 1px 1px 0 var(--highlight),inset -1px -1px 0 var(--shadow)">{s.data.title}</a>
            ))}
            <a href="/" style="font-family:var(--font-ui);font-size:0.6rem;padding:4px 10px;background:var(--face);text-decoration:none;color:var(--text);box-shadow:inset 1px 1px 0 var(--highlight),inset -1px -1px 0 var(--shadow)">← Desktop</a>
          </div>
        </div>
      )}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.date.toISOString(),
    "author": { "@type": "Person", "name": site.author },
    "url": pageUrl,
  })}>
  </script>
</BaseLayout>
