---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { id: post.id } }));
}

const { id } = Astro.props;
const post = await getEntry("blog", id);
if (!post) return Astro.redirect("/");
// Redirect drafts in production (dev shows them)
const isDev = Astro.url.hostname === 'localhost';
if (post.data.draft && !isDev) return Astro.redirect("/");
const { Content } = await render(post);

const bodyText = post.body || "";
const chineseChars = (bodyText.match(/[一-鿿]/g) || []).length;
const englishWords = (bodyText.match(/[a-zA-Z]+/g) || []).length;
const readingMinutes = Math.max(1, Math.ceil(Math.max(chineseChars / 400, englishWords / 200)));

const formattedDate = post.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Maturity
function maturity(d: Date): string {
  const days = (Date.now() - d.getTime()) / 86400000;
  if (days < 30) return 'nova';
  if (days < 365) return 'main-sequence';
  return 'red-giant';
}
const postMaturity = maturity(post.data.date);

// Extract h2 headings for chapter cards
const h2Matches = bodyText.match(/^##\s+(.+)$/gm);
const chapters = h2Matches ? h2Matches.map(h => h.replace(/^##\s+/, '')) : [];

const allPosts = await getCollection("blog");
const publishedPosts = allPosts.filter(p => !p.data.draft || isDev);
const sortedAll = publishedPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = sortedAll.findIndex((p) => p.id === id);
const prevPost = currentIndex > 0 ? sortedAll[currentIndex - 1] : null;
const nextPost = currentIndex < sortedAll.length - 1 ? sortedAll[currentIndex + 1] : null;

// Series navigation
const seriesName = post.data.series;
const seriesPosts = seriesName
  ? publishedPosts.filter(p => p.data.series === seriesName).sort((a,b) => (a.data.seriesOrder??99) - (b.data.seriesOrder??99))
  : [];

// Related: same tags
const related = publishedPosts
  .filter(p => p.id !== id && p.data.tags.some(t => post.data.tags.includes(t)))
  .slice(0, 3);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="container" style="padding-top:40px;padding-bottom:40px">

    <!-- Back to star map -->
    <a href="/" class="back-link">
      ← Return to the star map
    </a>

    <!-- Header -->
    <header style="margin:24px 0 32px">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
        <h1 class="article-content" style="margin:0">{post.data.title}</h1>
        <button class="share-btn" id="shareBtn" title="Share this article" aria-label="Share">🔗 Share</button>
      </div>
      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        <span class="reading-time">~{readingMinutes} min read</span>
        <span class={`maturity-badge ${postMaturity}`}></span>
        {post.data.draft && <span class="maturity-badge" style="color:#ff6666;border-color:rgba(255,102,102,0.4);background:rgba(255,102,102,0.06)">📝 Draft</span>}
        {post.data.tags.length > 0 && (
          <div class="article-tags">
            {post.data.tags.map(tag => (
              <a href={`/tags/${tag.toLowerCase()}`} class="article-tag">{tag}</a>
            ))}
          </div>
        )}
      </div>
    </header>

    {/* Chapter cards for long articles */}
    {chapters.length >= 3 && (
      <nav class="chapter-grid" aria-label="Article chapters">
        {chapters.map((ch, i) => (
          <a href={`#h-${i}`} class="chapter-card">
            <div class="chapter-card-num">Part {String(i+1).padStart(2,'0')}</div>
            <div class="chapter-card-title">{ch}</div>
          </a>
        ))}
      </nav>
    )}

    {/* Series navigation */}
    {seriesPosts.length > 1 && (
      <nav class="series-nav">
        <div class="series-nav-title">🌌 Galaxy: {seriesName}</div>
        <div class="series-nav-list">
          {seriesPosts.map(sp => (
            <a href={`/blog/${sp.id}`} class={`series-nav-item${sp.id===id?' current':''}`}>
              <span class="series-nav-label">Part {sp.data.seriesOrder ?? '·'}</span>
              <span class="series-nav-name">{sp.data.title}</span>
            </a>
          ))}
        </div>
      </nav>
    )}

    <!-- Content with TOC sidebar -->
    <div class="post-with-toc">
      <div class="article-content" id="articleContent">
        <Content />
      </div>
      <aside class="toc-sidebar" id="tocSidebar">
        <div class="toc-title">📜 On This Page</div>
        <ul class="toc-list" id="tocList"></ul>
      </aside>
    </div>

    <!-- Post navigation -->
    <nav class="article-nav">
      {prevPost ? (
        <a href={`/blog/${prevPost.id}`}>
          <span class="article-nav-label">← Previous Star</span>
          <span class="article-nav-title">{prevPost.data.title}</span>
        </a>
      ) : <div></div>}
      {nextPost ? (
        <a href={`/blog/${nextPost.id}`} style="text-align:right">
          <span class="article-nav-label">Next Star →</span>
          <span class="article-nav-title">{nextPost.data.title}</span>
        </a>
      ) : <div></div>}
    </nav>

    <!-- Related stars -->
    {related.length > 0 && (
      <div style="margin-top:48px;padding-top:24px;border-top:1px solid var(--border)">
        <h3 style="font-family:var(--font-display);font-size:var(--text-sm);color:var(--star-gold);margin-bottom:16px;letter-spacing:0.06em">
          ✦ Nearby Stars
        </h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
          {related.map(rp => (
            <a href={`/blog/${rp.id}`} style="padding:12px 16px;background:var(--surface);border:1px solid var(--border);border-radius:6px;text-decoration:none;transition:all 0.3s;display:block">
              <div style="font-family:var(--font-display);font-size:var(--text-xs);color:var(--star-gold);margin-bottom:4px">{rp.data.title}</div>
              <div style="font-family:var(--font-mono);font-size:var(--text-2xs);color:var(--text-muted)">{rp.data.date.toLocaleDateString("zh-CN",{year:"numeric",month:"short",day:"numeric"})}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>

  <!-- Share button -->
  <script>
    (function(){
      var shareBtn=document.getElementById('shareBtn');
      if(shareBtn){
        shareBtn.addEventListener('click',function(){
          navigator.clipboard.writeText(window.location.href).then(function(){
            shareBtn.textContent='✓ Link Copied!';
            shareBtn.classList.add('shared');
            setTimeout(function(){shareBtn.textContent='🔗 Share';shareBtn.classList.remove('shared')},2000);
          });
        });
      }
    })();
  </script>

  <!-- TOC generation -->
  <script>
    (function(){
      var content=document.getElementById('articleContent'),tocList=document.getElementById('tocList'),sidebar=document.getElementById('tocSidebar');
      if(!content||!tocList||!sidebar)return;
      var headings=content.querySelectorAll('h2,h3');
      if(headings.length<2){sidebar.style.display='none';return}
      var items=[];
      headings.forEach(function(h,i){
        var id='h-'+i;h.id=id;
        // Add anchor link on hover
        var anchor=document.createElement('a');
        anchor.className='heading-anchor';anchor.href='#'+id;
        anchor.innerHTML='#';
        anchor.title='Copy link to this section';
        anchor.addEventListener('click',function(e){
          e.preventDefault();
          var url=window.location.origin+window.location.pathname+'#'+id;
          navigator.clipboard.writeText(url).then(function(){
            anchor.classList.add('anchor-copied');
            anchor.textContent='✓';
            setTimeout(function(){anchor.classList.remove('anchor-copied');anchor.textContent='#'},1500);
          });
        });
        h.appendChild(anchor);

        var li=document.createElement('li');li.className='toc-item';
        var a=document.createElement('a');a.className='toc-link'+(h.tagName==='H3'?' toc-link--h3':'');
        a.href='#'+id;a.textContent=h.textContent;
        a.addEventListener('click',function(e){e.preventDefault();h.scrollIntoView({behavior:'smooth',block:'start'});history.pushState(null,'','#'+id)});
        li.appendChild(a);tocList.appendChild(li);items.push({el:a,id:id});
      });
      // Highlight on scroll
      var observer=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){items.forEach(function(it){it.el.classList.remove('active')});var found=items.find(function(it){return it.id===e.target.id});if(found)found.el.classList.add('active')}})},{rootMargin:'-80px 0px -70% 0px',threshold:0});
      headings.forEach(function(h){observer.observe(h)});

      // ── Collapse inline TOC (long article table of contents in markdown) ──
      var firstUl=content.querySelector('ul');
      if(firstUl){
        var links=firstUl.querySelectorAll('a[href^="#"]');
        if(links.length>=6){
          var details=document.createElement('details');
          details.className='inline-toc-collapse';
          var summary=document.createElement('summary');
          summary.textContent='📜 目录 ('+links.length+' 章节) — 点击展开';
          details.appendChild(summary);
          firstUl.parentNode.insertBefore(details,firstUl);
          details.appendChild(firstUl);
        }
      }
    })();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"BlogPosting",
    "headline":post.data.title,"description":post.data.description,
    "datePublished":post.data.date.toISOString(),
    "author":{"@type":"Person","name":site.author},"url":pageUrl,
  })}></script>
</BaseLayout>

<style>
  .back-link{
    display:inline-flex;align-items:center;gap:6px;
    font-family:var(--font-mono);font-size:var(--text-xs);color:var(--text-muted);
    text-decoration:none;transition:color 0.3s;
  }
  .back-link:hover{color:var(--star-gold);text-shadow:none}
</style>
