---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import AmbientGlow from "../components/AmbientGlow.astro";
import BilibiliBanner from "../components/BilibiliBanner.astro";
import PixelCat from "../components/PixelCat.astro";
import BlogCard from "../components/BlogCard.astro";
import TagsBar from "../components/TagsBar.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");

function calcReadingTime(body: string) {
  const chineseChars = (body.match(/[一-鿿]/g) || []).length;
  const englishWords = (body.match(/[a-zA-Z]+/g) || []).length;
  return `${Math.max(1, Math.ceil(Math.max(chineseChars / 400, englishWords / 200)))} min read`;
}

const sortedPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagMap = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout>
  <AmbientGlow />

  <Hero postCount={sortedPosts.length} tagCount={tags.length} />

  <BilibiliBanner />

  <section id="posts" class="section">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="section-title">Latest writing</h2>
        <p class="section-subtitle">Thoughts on code.</p>
      </div>

      {tags.length > 0 && <div class="reveal"><TagsBar tags={tags} activeTag="" /></div>}

      {
        sortedPosts.length === 0 ? (
          <div class="empty-state reveal">
            <p>No posts yet. Start writing in <code>src/content/blog/</code>.</p>
          </div>
        ) : (
          <>
            <!-- View toggle -->
            <div class="view-toggle reveal" id="viewToggle">
              <button class="view-btn lggc active" data-view="grid" aria-label="Grid view" id="viewGridBtn">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="1" y="1" width="6" height="6" rx="1"/>
                  <rect x="9" y="1" width="6" height="6" rx="1"/>
                  <rect x="1" y="9" width="6" height="6" rx="1"/>
                  <rect x="9" y="9" width="6" height="6" rx="1"/>
                </svg>
              </button>
              <button class="view-btn lggc" data-view="list" aria-label="List view" id="viewListBtn">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M2 4h12M2 8h12M2 12h12" stroke-linecap="round"/>
                </svg>
              </button>
            </div>

            <!-- Grid view -->
            <div class="blog-grid reveal-stagger" id="blogGrid">
              {sortedPosts.map((post) => (
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.date.toISOString()}
                  slug={post.id}
                  readingTime={calcReadingTime(post.body || "")}
                  tags={post.data.tags}
                />
              ))}
            </div>

            <!-- List view (hidden by default) -->
            <div class="blog-list" id="blogList" style="display:none">
              {sortedPosts.map((post) => (
                <a href={`/blog/${post.id}`} class="blog-list-item">
                  <span class="blog-list-date">
                    {post.data.date.toLocaleDateString("zh-CN", { month: "short", day: "numeric" })}
                  </span>
                  <div>
                    <div class="blog-list-title">{post.data.title}</div>
                    {post.data.tags.length > 0 && (
                      <div class="blog-list-tags">
                        {post.data.tags.map((tag) => (
                          <span class="blog-list-tag">{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>

  <section id="about" class="section">
    <div class="container reveal">
      <h2 class="section-title">Hello World!</h2>
      <div class="about-content">
        <p>Hello! I'm a developer who loves building things for the web. This is my space to share ideas, document learnings, and connect with others.</p>
        <p>Known as Jingzhou Yuanpeng — my one true passion is the relentless pursuit of better technology.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container reveal">
      <PixelCat />
    </div>
  </section>
</BaseLayout>

<script>
  // View toggle
  (function() {
    var gridBtn = document.getElementById("viewGridBtn");
    var listBtn = document.getElementById("viewListBtn");
    var grid = document.getElementById("blogGrid");
    var list = document.getElementById("blogList");

    if (!gridBtn || !listBtn || !grid || !list) return;

    var view = localStorage.getItem("blogView") || "grid";
    applyView(view);

    gridBtn.addEventListener("click", function() { applyView("grid"); });
    listBtn.addEventListener("click", function() { applyView("list"); });

    function applyView(v) {
      view = v;
      localStorage.setItem("blogView", v);
      grid.style.display = v === "grid" ? "" : "none";
      list.style.display = v === "list" ? "" : "none";
      gridBtn.classList.toggle("active", v === "grid");
      listBtn.classList.toggle("active", v === "list");

      // Re-init staggered reveal for grid view
      if (v === "grid") {
        grid.classList.remove("revealed");
        requestAnimationFrame(function() {
          grid.classList.add("revealed");
        });
      }
    }
  })();
</script>

<style>
  .section-header {
    margin-bottom: var(--space-xs);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl) var(--space-xl);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border-strong);
    color: var(--color-text-secondary);
  }

  .empty-state code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--color-code-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .about-content {
    max-width: 640px;
  }

  .about-content p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }
</style>
