---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import {site} from '../data/site';
import {projects} from '../data/projects';
import {getPosts} from '../lib/posts';
import {path} from '../lib/urls';
const posts = await getPosts();
---
<Base title={site.name}>
  <section class="hero entrance"><p class="eyebrow">思考 · 记录 · 作品</p><h1>{site.name}</h1><p class="intro">{site.description}</p><div class="hero-links">{posts.length > 0 && <a class="button primary" href={path('posts/')}>阅读文章 <span aria-hidden="true">→</span></a>}{projects.length > 0 && <a class="button" href="#projects">查看作品 <span aria-hidden="true">↓</span></a>}{posts.length === 0 && projects.length === 0 && <a class="text-link" href={path('about/')}>关于作者 <span aria-hidden="true">→</span></a>}</div></section>
  {projects.length > 0 && <section id="projects" class="home-section"><div class="section-heading"><h2>精选作品</h2><span class="muted">从想法到实现</span></div><div class="project-grid">{projects.map((p,i) => <div class:list={[{'entrance':i<3}]} style={`--delay:${(i+1)*40}ms`}><ProjectCard project={p} eager={i===0} /></div>)}</div></section>}
  <section class="home-section"><div class="section-heading"><h2>最近文章</h2>{posts.length > 0 && <a href={path('posts/')}>全部文章 <span aria-hidden="true">→</span></a>}</div>{posts.length ? <PostList posts={posts.slice(0,3)} /> : <p class="empty-state">还没有发布文章。写好一篇，再放在这里。</p>}</section>
</Base>
