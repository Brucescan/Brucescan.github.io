---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestPost = sortedPosts[0];

// Build tag list
const tagMap = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout>
  <!-- Desktop Icons -->
  <Fragment slot="icons">
    <!-- Quest Log -->
    <div class="desk-icon" data-action="open-window" data-target="questlog" title="Quest Log — Browse all articles">
      <div class="desk-icon-sprite">📖</div>
      <div class="desk-icon-label">Quest Log</div>
    </div>

    <!-- Latest Post -->
    {latestPost && (
      <div class="desk-icon" data-action="open-article" data-target={latestPost.id} title={`Latest: ${latestPost.data.title}`}>
        <div class="desk-icon-sprite">📜</div>
        <div class="desk-icon-label">Latest Scroll</div>
      </div>
    )}

    <!-- Spell Schools -->
    <div class="desk-icon" data-action="open-window" data-target="tags" title="Spell Schools — Browse by tag">
      <div class="desk-icon-sprite">📁</div>
      <div class="desk-icon-label">Spell Schools</div>
    </div>

    <!-- README -->
    <div class="desk-icon" data-action="open-window" data-target="about" title="README.txt — About this realm">
      <div class="desk-icon-sprite">ℹ️</div>
      <div class="desk-icon-label">README.txt</div>
    </div>

    <!-- Cat Runner -->
    <div class="desk-icon" data-action="open-window" data-target="catgame" title="Cat Runner — Mini game">
      <div class="desk-icon-sprite">🐱</div>
      <div class="desk-icon-label">Cat Runner</div>
    </div>

    <!-- Individual article icons -->
    {sortedPosts.slice(0, 4).map((post) => (
      <div class="desk-icon" data-action="open-article" data-target={post.id} title={post.data.title}>
        <div class="desk-icon-sprite">📝</div>
        <div class="desk-icon-label">{post.data.title.length > 12 ? post.data.title.substring(0, 12) + '…' : post.data.title}</div>
      </div>
    ))}
  </Fragment>

  <!-- Hidden templates for SEO and content -->
  <Fragment slot="templates">
    <!-- These are indexed by search engines -->
    <div id="seo-content" style="display:none" aria-hidden="true">
      <h1>Flazi的桃花源 — Blog</h1>
      <p>A retro fantasy operating system and blog. Browse quests (articles), explore spell schools (tags), and discover knowledge.</p>
      <ul>
        {sortedPosts.map((post) => (
          <li><a href={`/blog/${post.id}`}>{post.data.title}</a> — {post.data.description}</li>
        ))}
      </ul>
    </div>
  </Fragment>

  <!-- Pass tag data to window manager -->
  <script set:html={`window._tagData = ${JSON.stringify(tags)};`}></script>
</BaseLayout>
