---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const publishedPosts = allPosts.filter(p => !p.data.draft);
const sortedPosts = publishedPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Maturity helper
function maturity(d: Date): string {
  const days = (Date.now() - d.getTime()) / 86400000;
  if (days < 30) return 'nova';
  if (days < 365) return 'main-sequence';
  return 'red-giant';
}

// ── Spectral class per tag ──
const spectralMap: Record<string, {color:string;glow:string;size:number}> = {
  'c++':       {color:'#88bbff',glow:'rgba(136,187,255,0.5)',size:1.3},
  'programming':{color:'#99ccff',glow:'rgba(153,204,255,0.4)',size:1.1},
  'design':    {color:'#ffd700',glow:'rgba(255,215,0,0.5)',size:1.2},
  'typography':{color:'#ffcc88',glow:'rgba(255,204,136,0.4)',size:0.95},
  'philosophy':{color:'#cc88ff',glow:'rgba(204,136,255,0.5)',size:1.15},
  'personal':  {color:'#ffaa66',glow:'rgba(255,170,102,0.5)',size:1.0},
  'writing':   {color:'#ffccaa',glow:'rgba(255,204,170,0.4)',size:0.9},
  'tutorial':  {color:'#66ddbb',glow:'rgba(102,221,187,0.5)',size:1.25},
  'astro':     {color:'#ff8844',glow:'rgba(255,136,68,0.5)',size:1.1},
  'web development':{color:'#66bbff',glow:'rgba(102,187,255,0.4)',size:1.05},
  'notes':     {color:'#aaccee',glow:'rgba(170,204,238,0.4)',size:0.9},
};

function getSpectral(tags: string[]) {
  for (const t of tags) {
    const key = t.toLowerCase();
    if (spectralMap[key]) return spectralMap[key];
  }
  return {color:'#ffe8c0',glow:'rgba(255,232,192,0.4)',size:0.95};
}

// ── Deterministic hash for stable star positions ──
function hashStr(s:string):number{let h=0;for(let i=0;i<s.length;i++){h=((h<<5)-h)+s.charCodeAt(i);h|=0}return Math.abs(h)}

// ── Fermat spiral ──
const goldenAngle = Math.PI * (3 - Math.sqrt(5));
const scale = 50;
const stars = sortedPosts.map((post, i) => {
  const spectral = getSpectral(post.data.tags);
  const r = scale * Math.sqrt(i + 1);
  const theta = (i + 1) * goldenAngle;
  const h = hashStr(post.id);
  const jitterR = (((h % 100) / 100) - 0.5) * 16;
  const jitterT = (((hashStr(post.id+'t') % 100) / 100) - 0.5) * 0.25;
  return {
    id: post.id, title: post.data.title, desc: post.data.description,
    date: post.data.date,
    x: Math.round(Math.cos(theta + jitterT) * (r + jitterR)),
    y: Math.round(Math.sin(theta + jitterT) * (r + jitterR)),
    color: spectral.color, glow: spectral.glow, size: spectral.size,
    tags: post.data.tags, maturity: maturity(post.data.date),
  };
});

// Tag list
const tagMap = new Map<string,number>();
for (const post of publishedPosts) for (const t of post.data.tags) tagMap.set(t,(tagMap.get(t)||0)+1);
const allTags = Array.from(tagMap.entries()).map(([n,c])=>({name:n,count:c})).sort((a,b)=>b.count-a.count);

// Tag -> post IDs mapping for hover highlight
const tagToPosts = new Map<string,string[]>();
for (const post of publishedPosts) for (const t of post.data.tags) {
  const key = t.toLowerCase();
  if (!tagToPosts.has(key)) tagToPosts.set(key, []);
  tagToPosts.get(key)!.push(post.id);
}
// Post ID -> its tags
const postTags: Record<string,string[]> = {};
for (const post of publishedPosts) postTags[post.id] = post.data.tags.map(t=>t.toLowerCase());

// Deep space objects (decorative drifting dots in empty areas)
const deepSpaceCount = Math.max(8, 20 - sortedPosts.length * 2);
const deepSpaceObjects = Array.from({length: deepSpaceCount}, (_, i) => {
  const h = hashStr('deep'+i);
  return {
    x: ((h % 1000) / 1000 * 400) - 200,
    y: ((hashStr('deepy'+i) % 1000) / 1000 * 400) - 200,
    size: 1.5 + (h % 10) / 10 * 2,
    delay: (i * 0.7) % 6,
    opacity: 0.15 + (h % 30) / 100,
  };
});
---

<BaseLayout>
  <!-- ─── COSMIC CANVAS ─── -->
  <div class="cosmos" id="cosmos">
    <!-- Central sun / blog core -->
    <div class="cosmos-core" aria-hidden="true">
      <div class="core-glow"></div>
      <div class="core-body">
        <span class="core-symbol">✦</span>
      </div>
    </div>

    <!-- Star map -->
    <div class="star-field" id="starField">
      {/* Deep space objects */}
      {deepSpaceObjects.map((obj, i) => (
        <div
          class="deep-space-object"
          style={`position:absolute;top:50%;left:50%;transform:translate(calc(-50% + ${obj.x}px),calc(-50% + ${obj.y}px));width:${obj.size}px;height:${obj.size}px;background:rgba(255,208,102,${obj.opacity});box-shadow:0 0 ${obj.size*2}px rgba(255,208,102,${obj.opacity});animation-delay:${obj.delay}s;border-radius:50%`}
          aria-hidden="true"
        ></div>
      ))}

      {stars.map((star, i) => (
        <a
          href={`/blog/${star.id}`}
          class="celestial-body"
          data-tags={star.tags.map(t=>t.toLowerCase()).join(',')}
          style={`--star-x:${star.x}px;--star-y:${star.y}px;--star-color:${star.color};--star-glow:${star.glow};--star-size:${star.size};animation-delay:${i*0.06}s`}
          title={star.title}
        >
          <div class="star-core"></div>
          <div class="star-halo"></div>
          <div class="star-info">
            <div class="star-title">{star.title}</div>
            <div class="star-meta">
              {star.date.toLocaleDateString("zh-CN",{month:"short",day:"numeric"})}
              {star.tags.length > 0 && <> · {star.tags[0]}</>}
              <span class={`maturity-badge ${star.maturity}`}></span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Constellation lines (SVG overlay, same coordinate space as stars) -->
    <svg class="constellations" viewBox="-200 -200 400 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {stars.slice(0, -1).map((star, i) => {
        // Connect sequential stars if nearby
        const next = stars[i + 1];
        const dx = next.x - star.x, dy = next.y - star.y;
        const dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < 110) {
          return <line x1={star.x} y1={star.y} x2={next.x} y2={next.y} stroke="rgba(255,208,102,0.12)" stroke-width="1" vector-effect="non-scaling-stroke"/>;
        }
        return null;
      })}
    </svg>
  </div>

  <!-- ─── INFO PANEL ─── -->
  <div class="info-panel container reveal">
    <div class="info-card">
      <h2 class="info-title">✦ Welcome, Traveler</h2>
      <p class="info-text">
        You have entered <strong>The Cosmic Codex</strong> — a living star map
        where each article is a celestial body and every tag forms a constellation.
        {sortedPosts.length} stars shine in this galaxy{allPosts.length > sortedPosts.length && <>, {allPosts.length - sortedPosts.length} still forming in the nebula</>}. Click any star to begin your journey.
      </p>
      <div class="info-tags">
        <span class="info-tags-label">Navigate by constellation:</span>
        {allTags.slice(0,8).map(tag => (
          <a href={`/tags/${tag.name.toLowerCase()}`} class="info-tag-link">{tag.name} · {tag.count}</a>
        ))}
      </div>
    </div>
  </div>

  <!-- SEO -->
  <div style="display:none" aria-hidden="true">
    <h1>Flazi的桃花源 — The Cosmic Codex</h1>
    <p>{sortedPosts.length} articles about C++, design, programming and more.</p>
    <ul>{sortedPosts.map(p=><li><a href={`/blog/${p.id}`}>{p.data.title}</a></li>)}</ul>
  </div>

  <script type="application/json" id="tagPostMap" set:html={JSON.stringify(Object.fromEntries(tagToPosts))}></script>
  <script type="application/json" id="postTagsMap" set:html={JSON.stringify(postTags)}></script>
</BaseLayout>

<style>
  /* ── COSMOS CONTAINER ── */
  .cosmos{
    position:relative;width:100%;min-height:85vh;
    display:flex;align-items:center;justify-content:center;
    padding:80px 20px;
  }

  /* ── CENTRAL SUN ── */
  .cosmos-core{
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    z-index:10;pointer-events:none;
    width:80px;height:80px;display:flex;align-items:center;justify-content:center;
  }
  .core-glow{
    position:absolute;inset:-60px;border-radius:50%;
    background:radial-gradient(circle,var(--star-glow) 0%,rgba(255,208,102,0.1) 30%,transparent 70%);
    animation:corePulse 3s ease-in-out infinite;
  }
  @keyframes corePulse{0%,100%{transform:scale(1);opacity:0.6}50%{transform:scale(1.3);opacity:1}}
  .core-body{
    width:20px;height:20px;border-radius:50%;background:var(--star-gold);
    box-shadow:0 0 30px var(--star-glow),0 0 60px var(--star-glow),0 0 120px rgba(255,208,102,0.3);
    display:flex;align-items:center;justify-content:center;
    animation:coreBeat 2s ease-in-out infinite;
  }
  @keyframes coreBeat{0%,100%{transform:scale(1)}50%{transform:scale(1.5)}}
  .core-symbol{font-size:0.7rem;color:var(--void);animation:coreSpin 8s linear infinite}
  @keyframes coreSpin{to{transform:rotate(360deg)}}

  /* ── STAR FIELD ── */
  .star-field{
    position:relative;width:min(600px,90vw);height:min(600px,90vw);
    aspect-ratio:1;
  }

  .celestial-body{
    position:absolute;top:50%;left:50%;
    transform:translate(calc(-50% + var(--star-x)), calc(-50% + var(--star-y)));
    width:calc(28px * var(--star-size));height:calc(28px * var(--star-size));
    display:flex;align-items:center;justify-content:center;
    text-decoration:none;border-radius:50%;
    cursor:pointer;z-index:5;
    animation:starAppear 0.6s ease-out both;
    transition:transform 0.3s ease,z-index 0s;
  }
  @keyframes starAppear{from{opacity:0;transform:translate(calc(-50% + var(--star-x)),calc(-50% + var(--star-y))) scale(0)}}

  .star-core{
    width:100%;height:100%;border-radius:50%;
    background:radial-gradient(circle at 40% 35%,var(--star-color),rgba(0,0,0,0.8));
    box-shadow:0 0 calc(10px * var(--star-size)) var(--star-glow),
               0 0 calc(25px * var(--star-size)) var(--star-glow);
    transition:all 0.4s ease;
  }

  .star-halo{
    position:absolute;inset:-40%;border-radius:50%;
    background:radial-gradient(circle,var(--star-glow) 0%,transparent 70%);
    opacity:0;transition:opacity 0.4s ease;
  }

  .star-info{
    position:absolute;top:calc(100% + 12px);left:50%;transform:translateX(-50%);
    text-align:center;white-space:nowrap;pointer-events:none;
    opacity:0;transition:opacity 0.3s ease;
  }
  .star-title{
    font-family:var(--font-display);font-size:0.6rem;color:var(--star-gold);
    letter-spacing:0.06em;margin-bottom:2px;
  }
  .star-meta{font-family:var(--font-mono);font-size:0.5rem;color:var(--text-muted)}

  /* ── HOVER EFFECTS ── */
  .celestial-body:hover{z-index:50!important}
  .celestial-body:hover .star-core{
    box-shadow:0 0 calc(20px * var(--star-size)) var(--star-glow),
               0 0 calc(50px * var(--star-size)) var(--star-glow),
               0 0 calc(80px * var(--star-size)) rgba(255,208,102,0.3);
    filter:brightness(1.5);
  }
  .celestial-body:hover .star-halo{opacity:1}
  .celestial-body:hover .star-info{opacity:1}

  /* Tag-match highlight (hover) */
  .celestial-body.star-dim{opacity:0.25;transition:opacity 0.4s}
  .celestial-body.star-match{opacity:1;z-index:20}
  .celestial-body.star-match .star-core{box-shadow:0 0 calc(25px * var(--star-size)) var(--star-glow),
               0 0 calc(60px * var(--star-size)) var(--star-glow),
               0 0 calc(90px * var(--star-size)) rgba(255,208,102,0.35)}

  /* ── CONSTELLATIONS SVG ── */
  .constellations{
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    width:min(600px,90vw);height:min(600px,90vw);
    pointer-events:none;z-index:2;
  }

  /* ── INFO PANEL ── */
  .info-panel{padding:60px 0 80px;position:relative;z-index:20}
  .info-card{text-align:center;max-width:600px;margin:0 auto}
  .info-title{font-family:var(--font-display);font-size:var(--text-xl);color:var(--star-gold);margin-bottom:16px;letter-spacing:0.06em}
  .info-text{font-size:var(--text-base);line-height:1.7;color:var(--text-dim);margin-bottom:24px}
  .info-tags{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:8px}
  .info-tags-label{font-family:var(--font-mono);font-size:var(--text-2xs);color:var(--text-muted);width:100%;margin-bottom:4px}
  .info-tag-link{
    font-family:var(--font-display);font-size:0.55rem;letter-spacing:0.04em;
    color:var(--star-gold);padding:3px 12px;border:1px solid var(--border);border-radius:10px;
    transition:all 0.3s;text-decoration:none;
  }
  .info-tag-link:hover{background:rgba(255,208,102,0.1);border-color:var(--star-gold);box-shadow:0 0 12px var(--star-glow);text-shadow:none}

  /* Reveal animation */
  .reveal{opacity:0;transform:translateY(20px);transition:opacity 0.6s,transform 0.6s}
  .reveal.revealed{opacity:1;transform:translateY(0)}

  /* ── RESPONSIVE ── */
  @media(max-width:768px){
    .star-field{width:95vw;height:95vw}
    .cosmos{padding:24px 0;min-height:60vh}
    .star-info{display:none}
    .celestial-body:hover .star-info{display:block}
    .info-title{font-size:var(--text-lg)}
  }
</style>

<script>
  (function(){
    // Scroll reveal
    var observer=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('revealed');observer.unobserve(e.target)}})
    },{threshold:0.15});
    document.querySelectorAll('.reveal').forEach(function(el){observer.observe(el)});

    // ── Core click easter egg (delegated to cosmos, avoids blocking star hover) ──
    var coreClickCount=0,coreClickTimer=null;
    var cosmos=document.getElementById('cosmos');
    var coreEl=document.querySelector('.cosmos-core');
    var coreBody=document.querySelector('.core-body');
    if(cosmos&&coreEl){
      cosmos.addEventListener('click',function(e){
        var rect=coreEl.getBoundingClientRect();
        var cx=rect.left+rect.width/2,cy=rect.top+rect.height/2;
        var dx=e.clientX-cx,dy=e.clientY-cy;
        if(Math.sqrt(dx*dx+dy*dy)>60)return; // Only within 60px of center
        coreClickCount++;
        if(coreClickTimer)clearTimeout(coreClickTimer);
        coreClickTimer=setTimeout(function(){coreClickCount=0},1500);
        if(coreClickCount>=7){
          coreClickCount=0;
          var core=document.querySelector('.cosmos-core');
          if(core){core.style.animation='none';core.offsetHeight;core.style.animation=''}
          var allStars=document.querySelectorAll('.celestial-body');
          allStars.forEach(function(s,idx){
            s.style.transition='all 0.3s ease';
            s.style.transform='translate(calc(-50% + var(--star-x)),calc(-50% + var(--star-y))) scale(1.6)';
            s.style.opacity='1';
            s.style.zIndex='30';
            setTimeout(function(){s.style.transform='';s.style.opacity='';s.style.zIndex=''},500+idx*30);
          });
          if(coreBody){coreBody.style.transform='scale(3)';coreBody.style.transition='all 0.5s ease';setTimeout(function(){coreBody.style.transform='';coreBody.style.transition=''},600)}
        }
      });
    }

    // ── Parallax on mouse move ──
    var cosmos=document.getElementById('cosmos'),core=cosmos?.querySelector('.cosmos-core');
    if(cosmos&&core){
      cosmos.addEventListener('mousemove',function(e){
        var rect=cosmos.getBoundingClientRect();
        var x=(e.clientX-rect.left)/rect.width-0.5;
        var y=(e.clientY-rect.top)/rect.height-0.5;
        core.style.transform='translate(calc(-50% + '+(x*30)+'px), calc(-50% + '+(y*30)+'px))';
      });
      cosmos.addEventListener('mouseleave',function(){
        core.style.transform='translate(-50%,-50%)';
        core.style.transition='transform 1s ease-out';
        setTimeout(function(){core.style.transition=''},1000);
      });
    }

    // ── Hover highlight: same-tag stars glow together ──
    var tagPostMap={},postTagsMap={};
    try{tagPostMap=JSON.parse(document.getElementById('tagPostMap')?.textContent||'{}')}catch(e){}
    try{postTagsMap=JSON.parse(document.getElementById('postTagsMap')?.textContent||'{}')}catch(e){}

    starField.querySelectorAll('.celestial-body').forEach(function(star){
      star.addEventListener('mouseenter',function(){
        var href=star.getAttribute('href')?.replace('/blog/','')||'';
        var tags=postTagsMap[href]||[];
        // Collect ALL post IDs that share any tag with this star
        var relatedIds=new Set();
        tags.forEach(function(t){(tagPostMap[t]||[]).forEach(function(id){relatedIds.add(id)})});
        // If this star has no tags or is unique, only highlight itself
        if(relatedIds.size<=1){
          relatedIds=new Set([href]);
        }
        starField.querySelectorAll('.celestial-body').forEach(function(s){
          var sid=s.getAttribute('href')?.replace('/blog/','')||'';
          if(relatedIds.has(sid))s.classList.add('star-match');else s.classList.add('star-dim');
        });
      });
      star.addEventListener('mouseleave',function(){
        starField.querySelectorAll('.celestial-body').forEach(function(s){
          s.classList.remove('star-match','star-dim');
        });
      });
    });
  })();
</script>
