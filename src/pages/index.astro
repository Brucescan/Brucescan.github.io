---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import BlogCard from "../components/BlogCard.astro";
import TagsBar from "../components/TagsBar.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Build tag list with counts
const tagMap = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout>
  <Hero />

  <section id="posts" class="section">
    <div class="container">
      <h2 class="section-title">Latest writing</h2>
      <p class="section-subtitle">Thoughts on code, design, and the spaces in between.</p>

      {tags.length > 0 && <TagsBar tags={tags} activeTag="" />}

      {
        sortedPosts.length === 0 ? (
          <div class="empty-state">
            <p>No posts yet. Start writing in <code>src/content/blog/</code>.</p>
          </div>
        ) : (
          <div class="blog-grid">
            {sortedPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date.toISOString()}
                slug={post.id}
                readingTime={post.data.readingTime}
                tags={post.data.tags}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section id="about" class="section">
    <div class="container">
      <h2 class="section-title">Hello World!</h2>
      <div class="about-content">
        <p>Hello! I'm a developer who loves building things for the web. This is my space to share ideas, document learnings, and connect with others.</p>
        <p>When I'm not coding, you'll find me exploring cities, reading science fiction, and tinkering with side projects.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .empty-state {
    text-align: center;
    padding: var(--space-3xl) var(--space-xl);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border-strong);
    color: var(--color-text-secondary);
  }

  .empty-state code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--color-code-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .about-content {
    max-width: 640px;
  }

  .about-content p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }
</style>
