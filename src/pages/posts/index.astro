---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import {getPosts} from '../../lib/posts';
const posts = await getPosts();
---
<Base title="文章" description="按时间整理的文章与个人笔记。"><div class="reading-width page"><header class="page-heading"><h1>文章</h1><p class="intro">把过程写下来，让思考有迹可循。</p></header>{posts.length ? <PostList posts={posts} grouped /> : <p class="empty-state">还没有发布文章。</p>}</div></Base>
