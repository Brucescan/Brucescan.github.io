---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Game Over">
  <section class="not-found">
    <div class="container">
      <!-- Game Over screen -->
      <div class="gameover-screen">
        <div class="gameover-title">GAME OVER</div>
        <div class="gameover-code">ERROR 404</div>

        <div class="gameover-divider">
          <span>▼</span>
        </div>

        <div class="gameover-dialog dialog-box dialog-box--pointer">
          <p>A mysterious force blocks your path...</p>
          <p>This page has vanished into the void between dimensions.</p>
        </div>

        <div class="gameover-actions">
          <a href="/" class="pixel-btn pixel-btn--primary">
            ▶ Continue (Home)
          </a>
          <button class="pixel-btn" id="nfSearchBtn">
            🔍 Search
          </button>
        </div>

        <!-- Decorative pixel art -->
        <div class="gameover-cat-wrap">
          <canvas id="nfCatCanvas" width="64" height="64" aria-label="Pixel cat" title="Click me!"></canvas>
          <p class="gameover-cat-hint" id="nfCatHint">▶ Click the cat</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  (function() {
    var c = document.getElementById("nfCatCanvas");
    if (!c) return;
    var ctx = c.getContext("2d");
    if (!ctx) return;

    var animFrame = 0;
    var squished = false;

    function drawCat(squish) {
      ctx.clearRect(0, 0, 64, 64);

      if (squish) {
        // Squished / surprised pixel cat
        ctx.fillStyle = "#ff7733"; ctx.fillRect(18, 40, 28, 12);
        ctx.fillStyle = "#ff9944"; ctx.fillRect(14, 22, 36, 20);
        ctx.fillStyle = "#ff7733"; ctx.fillRect(14, 10, 10, 14); ctx.fillRect(40, 10, 10, 14);
        ctx.fillStyle = "#0b0b1f"; ctx.fillRect(22, 24, 8, 8); ctx.fillRect(34, 24, 8, 8);
        ctx.fillStyle = "#fff"; ctx.fillRect(24, 25, 4, 4); ctx.fillRect(36, 25, 4, 4);
        ctx.fillStyle = "#ee3333"; ctx.fillRect(28, 36, 8, 4);
        ctx.fillStyle = "#ff9944"; ctx.fillRect(18, 50, 12, 8); ctx.fillRect(34, 50, 12, 8);
        ctx.fillStyle = "#ff7733"; ctx.fillRect(0, 38, 10, 8); ctx.fillRect(54, 38, 10, 8);
      } else {
        // Idle cat
        ctx.fillStyle = "#ff7733"; ctx.fillRect(20, 24, 24, 20);
        ctx.fillStyle = "#ff9944"; ctx.fillRect(16, 8, 32, 20);
        ctx.fillStyle = "#ff7733"; ctx.fillRect(16, 0, 8, 12); ctx.fillRect(40, 0, 8, 12);
        ctx.fillStyle = "#ffcc66"; ctx.fillRect(18, 2, 4, 8); ctx.fillRect(42, 2, 4, 8);
        ctx.fillStyle = "#0b0b1f"; ctx.fillRect(24, 14, 4, 6); ctx.fillRect(36, 14, 4, 6);
        ctx.fillStyle = "#fff"; ctx.fillRect(26, 14, 2, 2); ctx.fillRect(38, 14, 2, 2);
        ctx.fillStyle = "#ee3333"; ctx.fillRect(30, 20, 4, 3);
        ctx.fillStyle = "#0b0b1f"; ctx.fillRect(28, 24, 8, 2);
        ctx.fillStyle = "#ff9944"; ctx.fillRect(20, 44, 10, 6); ctx.fillRect(34, 44, 10, 6);

        // Tail wag
        var tail = Math.sin(animFrame * 0.15) * 3;
        ctx.fillStyle = "#ff7733";
        ctx.fillRect(42 + tail, 26, 6, 4);
        ctx.fillRect(44 + tail, 22, 5, 5);
      }
    }

    function animate() {
      animFrame++;
      drawCat(squished);
      requestAnimationFrame(animate);
    }

    drawCat(false);
    animate();

    var hint = document.getElementById("nfCatHint");
    c.addEventListener("click", function() {
      squished = true;
      if (hint) hint.textContent = "Boop! ★";
      setTimeout(function() {
        squished = false;
        if (hint) hint.textContent = "▶ Click the cat";
      }, 400);
    });

    // Search button
    var searchBtn = document.getElementById("nfSearchBtn");
    if (searchBtn) {
      searchBtn.addEventListener("click", function() {
        var trigger = document.getElementById("searchTrigger");
        if (trigger) {
          trigger.click();
        } else {
          var overlay = document.getElementById("searchOverlay");
          if (overlay) {
            overlay.classList.add("active");
            var input = document.getElementById("searchInput");
            if (input) input.focus();
            document.body.style.overflow = "hidden";
          }
        }
      });
    }
  })();
</script>

<style>
  .not-found {
    padding: var(--space-4xl) 0;
    min-height: 75vh;
    display: flex;
    align-items: center;
  }

  .not-found .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .gameover-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    max-width: 500px;
    width: 100%;
  }

  .gameover-title {
    font-family: var(--font-pixel);
    font-size: var(--text-3xl);
    color: var(--color-danger);
    text-shadow:
      3px 3px 0 var(--color-danger-dim),
      0 0 16px rgba(238,51,51,0.3);
    letter-spacing: 0.12em;
    animation: sprite-pulse 2s steps(4) infinite;
  }

  .gameover-code {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    margin-top: -8px;
  }

  .gameover-divider {
    color: var(--color-border);
    font-size: var(--text-sm);
    animation: sprite-bob 1.5s steps(3) infinite;
  }

  .gameover-dialog {
    width: 100%;
    text-align: center;
  }

  .gameover-dialog p {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-text-dim);
    margin-bottom: var(--space-xs);
  }

  .gameover-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  .gameover-cat-wrap {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  #nfCatCanvas {
    image-rendering: pixelated;
    width: 96px;
    height: 96px;
    cursor: pointer;
    transition: transform 0.1s steps(2);
  }
  #nfCatCanvas:hover { transform: scale(1.1); }

  .gameover-cat-hint {
    font-family: var(--font-pixel);
    font-size: var(--text-2xs);
    color: var(--color-text-dim);
    animation: cursor-blink 1.5s steps(2) infinite;
  }
</style>
