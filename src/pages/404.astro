---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="not-found">
    <div class="container">
      <div class="nf-content">
        <span class="nf-code">404</span>
        <h1 class="nf-title">Page not found</h1>
        <p class="nf-desc">The page you're looking for doesn't exist or has been moved.</p>
        <a href="/" class="btn btn-primary">Back home</a>
      </div>

      <canvas id="nfCat" width="64" height="64" aria-hidden="true"></canvas>
    </div>
  </section>
</BaseLayout>

<script>
  (function() {
    var c = document.getElementById("nfCat");
    if (!c) return;
    var ctx = c.getContext("2d");
    if (!ctx) return;
    // Small idle cat
    ctx.fillStyle = "#ff9f43"; ctx.fillRect(20,24,24,20);
    ctx.fillStyle = "#ffbe76"; ctx.fillRect(16,8,32,20);
    ctx.fillStyle = "#ff9f43"; ctx.fillRect(16,0,8,12); ctx.fillRect(40,0,8,12);
    ctx.fillStyle = "#fdcb6e"; ctx.fillRect(18,2,4,8);  ctx.fillRect(42,2,4,8);
    ctx.fillStyle = "#2d3436"; ctx.fillRect(24,14,4,6); ctx.fillRect(36,14,4,6);
    ctx.fillStyle = "#fff";    ctx.fillRect(26,14,2,2); ctx.fillRect(38,14,2,2);
    ctx.fillStyle = "#e17055"; ctx.fillRect(30,20,4,3);
    ctx.fillStyle = "#2d3436"; ctx.fillRect(28,24,8,2);
    ctx.fillStyle = "#ffbe76"; ctx.fillRect(20,44,10,6); ctx.fillRect(34,44,10,6);
    ctx.fillStyle = "#ff9f43"; ctx.fillRect(44,28,8,4); ctx.fillRect(48,24,5,10);
  })();
</script>

<style>
  .not-found {
    padding: var(--space-4xl) 0;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .not-found .container {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
  }

  .nf-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .nf-code {
    font-size: 6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-text-tertiary) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .nf-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nf-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: 360px;
    line-height: 1.6;
  }

  #nfCat {
    image-rendering: pixelated;
    width: 80px;
    height: 80px;
    opacity: 0.5;
  }
</style>
