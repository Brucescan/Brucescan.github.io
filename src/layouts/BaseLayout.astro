---
import { site } from "../data/site";
import { getCollection } from "astro:content";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const pageDesc = description ?? site.description;
const pageUrl = new URL(Astro.url.pathname, site.url).href;
const ogImg = ogImage ? new URL(ogImage, site.url).href : new URL("/images/og.jpg", site.url).href;

const allPosts2 = await getCollection("blog");
const published = allPosts2.filter(p => !p.data.draft);
const tagSet = new Set<string>();
for (const p of published) for (const t of p.data.tags) tagSet.add(t);
const firstTag = Array.from(tagSet).sort()[0]?.toLowerCase() ?? '';
const searchData = published.map(p => ({
  id: p.id, title: p.data.title, description: p.data.description,
  date: p.data.date.toISOString(),
  content: (p.body || '').replace(/[#*`\[\]()>!\-|~]/g,' ').replace(/\s+/g,' ').trim().slice(0, 400),
  tags: p.data.tags,
}));

// Maturity: nova (<30d), main-sequence (30d-1y), red-giant (>1y)
function maturity(d: Date): string {
  const days = (Date.now() - d.getTime()) / 86400000;
  if (days < 30) return 'nova';
  if (days < 365) return 'main-sequence';
  return 'red-giant';
}

const currentPath = Astro.url.pathname;
const isArticle = currentPath.startsWith('/blog/');
function isActive(href:string){if(href==='/')return currentPath==='/';return currentPath.startsWith(href)}
---

<!doctype html>
<html lang={site.lang} data-theme="dark">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content={pageDesc}><meta name="generator" content={Astro.generator}>
  <title>{pageTitle}</title>
  <link rel="canonical" href={pageUrl}>
  <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml">
  <meta property="og:title" content={pageTitle}><meta property="og:description" content={pageDesc}>
  <meta property="og:type" content="website"><meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={ogImg}><meta property="og:site_name" content={site.title}>
  <meta property="og:locale" content={site.lang}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}><meta name="twitter:description" content={pageDesc}>
  <meta name="twitter:image" content={ogImg}>
  <script is:inline>(function(){var s=localStorage.getItem("theme");document.documentElement.setAttribute("data-theme",s||"dark")})()</script>
  <!-- Console Easter Egg -->
  <script is:inline>
    console.log(
      '%c✦ %cTHE COSMIC CODEX %c✦',
      'color:#ffd875;font-size:24px;',
      'color:#ffd875;font-family:serif;font-size:24px;font-weight:bold;',
      'color:#ffd875;font-size:24px;'
    );
    console.log('%cYou seem curious about the stars. Welcome, traveler.%c', 'color:#c8c0b0;font-size:14px;', '');
    console.log('%cTry the Konami Code: ↑↑↓↓←→←→BA', 'color:#908878;font-size:11px;font-style:italic;');
  </script>
</head>
<body>
  <!-- Cosmic Background -->
  <div class="cosmic-bg" aria-hidden="true"></div>

  <!-- Header -->
  <header class="cosmic-header">
    <div class="cosmic-header-inner">
      <a href="/" class="cosmic-logo">
        <div class="cosmic-logo-dot"></div>
        {site.title}
      </a>
      <button class="hamburger" id="hamburger" aria-label="Menu">☰</button>
      <nav class="cosmic-nav" id="cosmicNav">
        <a href="/" class:list={[{active:isActive('/')}]}>Home</a>
        <a href="/timeline" class:list={[{active:isActive('/timeline')}]}>Timeline</a>
        <a href={`/blog/${searchData[0]?.id ?? ''}`} class:list={[{active:isActive('/blog')}]}>Read</a>
        <a href={`/tags/${firstTag}`} class:list={[{active:isActive('/tags')}]}>Tags</a>
        <a href="/nebula" class:list={[{active:isActive('/nebula')}]}>Nebula</a>
        <a href="https://github.com/brucescan" target="_blank" rel="noopener">About</a>
      </nav>
      <div class="cosmic-tools">
        <button class="cosmic-tool-btn" id="searchBtn" title="Search (Ctrl+K)" aria-label="Search">🔭</button>
        <button class="cosmic-tool-btn" id="themeBtn" title="Toggle theme" aria-label="Theme">☀</button>
        {isArticle && <button class="cosmic-tool-btn" id="ttsBtn" title="Read aloud" aria-label="TTS">🔊</button>}
        {isArticle && <button class="cosmic-tool-btn" id="immersiveBtn" title="Immersive mode" aria-label="Immersive">🕯</button>}
      </div>
    </div>
  </header>

  <!-- Reading progress bar -->
  <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>

  <!-- Page Content -->
  <slot />

  <!-- Back to top -->
  <button class="back-to-top" id="backToTop" aria-label="Back to top" title="Back to top">↑</button>

  <!-- Keyboard shortcuts panel -->
  <div class="kbd-panel-overlay" id="kbdPanel">
    <div class="kbd-panel">
      <div class="kbd-panel-title">⌨ Shortcuts</div>
      <div class="kbd-row"><span class="kbd-label">Search</span><span class="kbd-keys"><kbd class="kbd-key">Ctrl</kbd>+<kbd class="kbd-key">K</kbd></span></div>
      <div class="kbd-row"><span class="kbd-label">Quick search</span><span class="kbd-keys"><kbd class="kbd-key">/</kbd></span></div>
      <div class="kbd-row"><span class="kbd-label">Nav results</span><span class="kbd-keys"><kbd class="kbd-key">↑</kbd><kbd class="kbd-key">↓</kbd></span></div>
      <div class="kbd-row"><span class="kbd-label">Toggle theme</span><span class="kbd-keys"><kbd class="kbd-key">Ctrl</kbd>+<kbd class="kbd-key">T</kbd></span></div>
      <div class="kbd-row"><span class="kbd-label">Go home</span><span class="kbd-keys"><kbd class="kbd-key">Ctrl</kbd>+<kbd class="kbd-key">H</kbd></span></div>
      <div class="kbd-row"><span class="kbd-label">Show shortcuts</span><span class="kbd-keys"><kbd class="kbd-key">?</kbd></span></div>
      <div class="kbd-row"><span class="kbd-label">Secret code</span><span class="kbd-keys"><kbd class="kbd-key">↑↑↓↓←→←→BA</kbd></span></div>
      <button class="kbd-close" id="kbdClose">Press ESC or click to close</button>
    </div>
  </div>

  <!-- Footer -->
  <footer class="cosmic-footer">
    <div class="container">
      <p style="font-family:var(--font-display);font-size:var(--text-xs);color:var(--star-gold);letter-spacing:0.1em;margin-bottom:8px">
        ✦ THE COSMIC CODEX ✦
      </p>
      <p>&copy; {new Date().getFullYear()} {site.author} &middot; Made of stardust &middot; <a href="/rss.xml">RSS</a></p>
    </div>
  </footer>

  <!-- Search overlay -->
  <div class="search-overlay" id="searchOverlay">
    <div class="search-dialog">
      <div class="search-input-wrap">
        <span class="search-icon">🔭</span>
        <input class="search-input" id="searchInput" placeholder="Search the cosmos..." autocomplete="off">
        <span class="search-hint">ESC</span>
      </div>
      <div class="search-results" id="searchResults">
        <div class="search-empty">Type to discover stars...</div>
      </div>
      <div class="search-recent" id="searchRecent" style="display:none">
        <div class="search-recent-title">Recent explorations</div>
        <div class="search-recent-chips" id="searchRecentChips"></div>
      </div>
    </div>
  </div>

  <!-- Lightbox overlay -->
  <div class="lightbox-overlay" id="lightboxOverlay">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close">✕</button>
    <button class="lightbox-prev" id="lightboxPrev" aria-label="Previous">‹</button>
    <button class="lightbox-next" id="lightboxNext" aria-label="Next">›</button>
    <img class="lightbox-img" id="lightboxImg" src="" alt="">
    <div class="lightbox-counter" id="lightboxCounter"></div>
  </div>

  <!-- Toast notification -->
  <div class="toast-container" id="toastContainer" aria-live="polite"></div>

  <!-- Immersive exit -->
  <button class="immersive-exit" id="immersiveExit" title="Exit immersive mode">✕ Exit Immersion</button>

  <!-- Supernova overlay -->
  <div class="supernova-overlay" id="supernovaOverlay" aria-hidden="true">
    <div class="supernova-text">✦ SUPERNOVA ✦</div>
    <div class="supernova-particles" id="supernovaParticles"></div>
  </div>

  <script type="application/json" id="searchData" set:html={JSON.stringify(searchData)}></script>

  <script>
    (function(){
      // ── Data ──
      var sIdx=[];
      try{var rd=document.getElementById('searchData')?.textContent;if(rd)sIdx=JSON.parse(rd)}catch(e){}

      // ── Toast notification ──
      var toastTimer=null;
      function showToast(msg,icon){
        var container=document.getElementById('toastContainer');if(!container)return;
        var toast=document.createElement('div');toast.className='toast';
        toast.innerHTML=(icon||'✦')+' '+msg;
        container.appendChild(toast);
        requestAnimationFrame(function(){toast.classList.add('show')});
        setTimeout(function(){toast.classList.remove('show');setTimeout(function(){if(toast.parentNode)toast.parentNode.removeChild(toast)},300)},2200);
      }

      // ── Konami Code ──
      var konamiSeq=[],konamiCode=[38,38,40,40,37,39,37,39,66,65];
      var konamiFired=false;
      document.addEventListener('keydown',function(e){
        var t=e.target.tagName;
        if(t==='INPUT'||t==='TEXTAREA')return;
        if(konamiFired)return;
        konamiSeq.push(e.keyCode);
        if(konamiSeq.length>10)konamiSeq.shift();
        if(konamiSeq.length===10&&konamiSeq.every(function(k,i){return k===konamiCode[i]})){
          konamiFired=true;
          fireSupernova();
        }
      });
      function fireSupernova(){
        var overlay=document.getElementById('supernovaOverlay');
        var particles=document.getElementById('supernovaParticles');
        if(!overlay||!particles)return;
        overlay.classList.add('active');
        // Generate particles
        var frag='';
        for(var i=0;i<80;i++){
          var angle=Math.random()*360,dist=100+Math.random()*300,size=3+Math.random()*8;
          var color=['#ffd875','#ff8844','#ffcc88','#ffffff','#ffaa66'][Math.floor(Math.random()*5)];
          frag+='<div class="sn-particle" style="--a:'+angle+'deg;--d:'+dist+'px;--s:'+size+'px;--c:'+color+';--delay:'+(Math.random()*0.4).toFixed(2)+'s"></div>';
        }
        particles.innerHTML=frag;
        setTimeout(function(){overlay.classList.remove('active');konamiFired=false;particles.innerHTML=''},3000);
      }

      // ── Theme ──
      var themeBtn=document.getElementById('themeBtn');
      if(themeBtn){
        themeBtn.textContent=document.documentElement.getAttribute('data-theme')==='dark'?'☀':'☾';
        themeBtn.addEventListener('click',function(){
          var h=document.documentElement,n=h.getAttribute('data-theme')==='dark'?'light':'dark';
          h.classList.add('theme-transitioning');
          h.setAttribute('data-theme',n);localStorage.setItem('theme',n);
          themeBtn.textContent=n==='dark'?'☀':'☾';
          setTimeout(function(){h.classList.remove('theme-transitioning')},500);
        });
      }

      // ── Mobile nav ──
      var ham=document.getElementById('hamburger'),nav=document.getElementById('cosmicNav');
      if(ham&&nav){ham.addEventListener('click',function(){nav.classList.toggle('open')})}

      // ── Reading progress ──
      var prog=document.getElementById('readingProgress');
      if(prog){window.addEventListener('scroll',function(){var h=document.documentElement.scrollHeight-window.innerHeight;prog.style.width=h>0?Math.min(window.scrollY/h*100,100)+'%':'0'},{passive:true})}

      // ── Back to top ──
      var btt=document.getElementById('backToTop');
      if(btt){window.addEventListener('scroll',function(){var pct=Math.round(window.scrollY/(document.documentElement.scrollHeight-window.innerHeight)*100);btt.classList.toggle('visible',window.scrollY>400);btt.setAttribute('data-scroll-pct',Math.min(pct,100))},{passive:true});btt.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'})})}

      // ── Code copy buttons + language labels ──
      document.querySelectorAll('pre').forEach(function(pre){
        var wrap=document.createElement('div');wrap.className='code-block-wrap';
        pre.parentNode.insertBefore(wrap,pre);wrap.appendChild(pre);

        // Language label
        var code=pre.querySelector('code');
        var langClass=code?.className||'';
        var langMatch=langClass.match(/language-(\w+)/);
        if(langMatch){
          var label=document.createElement('span');label.className='code-lang-label';
          label.textContent=langMatch[1];
          wrap.appendChild(label);
        }

        // Copy button
        var btn=document.createElement('button');btn.className='copy-btn';btn.textContent='📋 Copy';
        wrap.appendChild(btn);
        btn.addEventListener('click',function(){
          var codeText=pre.querySelector('code')?.textContent||pre.textContent||'';
          navigator.clipboard.writeText(codeText).then(function(){
            btn.textContent='✓ Copied';btn.classList.add('copied');
            showToast('Code copied to clipboard','📋');
            setTimeout(function(){btn.textContent='📋 Copy';btn.classList.remove('copied')},2000);
          });
        });
      });

      // ── Random warp ──
      var randomBtn=document.getElementById('randomBtn');
      if(randomBtn&&randomIds.length){
        randomBtn.addEventListener('click',function(){
          var id=randomIds[Math.floor(Math.random()*randomIds.length)];
          if(id)window.location.href='/blog/'+id;
        });
      }

      // ── Immersive mode ──
      var immersiveBtn=document.getElementById('immersiveBtn'),immersiveExit=document.getElementById('immersiveExit');
      function enterImmersive(){document.body.classList.add('immersive');immersiveExit.classList.add('visible')}
      function exitImmersive(){document.body.classList.remove('immersive');immersiveExit.classList.remove('visible')}
      if(immersiveBtn)immersiveBtn.addEventListener('click',enterImmersive);
      if(immersiveExit)immersiveExit.addEventListener('click',exitImmersive);

      // ── TTS (Text-to-Speech) ──
      var ttsBtn=document.getElementById('ttsBtn'),ttsSpeaking=false,ttsUtterance=null;
      if(ttsBtn&&window.speechSynthesis){
        ttsBtn.addEventListener('click',function(){
          if(ttsSpeaking){window.speechSynthesis.cancel();ttsSpeaking=false;ttsBtn.textContent='🔊';return}
          var article=document.querySelector('.article-content');
          if(!article)return;
          // Collect text from article, skipping code blocks
          var parts=[];article.querySelectorAll('p,h1,h2,h3,h4,li,blockquote').forEach(function(el){
            if(el.closest('pre'))return;
            var t=el.textContent?.trim();
            if(t)parts.push(t);
          });
          var text=parts.join('. ');
          if(!text)return;
          ttsUtterance=new SpeechSynthesisUtterance(text);
          ttsUtterance.lang='zh-CN';
          ttsUtterance.rate=0.9;
          ttsUtterance.onend=function(){ttsSpeaking=false;ttsBtn.textContent='🔊'};
          ttsUtterance.onerror=function(){ttsSpeaking=false;ttsBtn.textContent='🔊'};
          ttsSpeaking=true;ttsBtn.textContent='⏹';
          window.speechSynthesis.speak(ttsUtterance);
        });
      }

      // ── Image lightbox ──
      var lbOverlay=document.getElementById('lightboxOverlay'),lbImg=document.getElementById('lightboxImg'),
          lbClose=document.getElementById('lightboxClose'),lbPrev=document.getElementById('lightboxPrev'),
          lbNext=document.getElementById('lightboxNext'),lbCounter=document.getElementById('lightboxCounter');
      var lbImages=[],lbIdx=0;
      function openLightbox(idx){
        lbIdx=idx;lbImg.src=lbImages[idx].src;lbImg.alt=lbImages[idx].alt||'';
        lbCounter.textContent=(idx+1)+' / '+lbImages.length;
        lbOverlay.classList.add('open');document.body.style.overflow='hidden';
      }
      function closeLightbox(){lbOverlay.classList.remove('open');document.body.style.overflow=''}
      function lbPrevFn(){if(lbImages.length>1){lbIdx=(lbIdx-1+lbImages.length)%lbImages.length;openLightbox(lbIdx)}}
      function lbNextFn(){if(lbImages.length>1){lbIdx=(lbIdx+1)%lbImages.length;openLightbox(lbIdx)}}
      if(lbOverlay){
        lbClose.addEventListener('click',closeLightbox);
        lbPrev.addEventListener('click',lbPrevFn);
        lbNext.addEventListener('click',lbNextFn);
        lbOverlay.addEventListener('click',function(e){if(e.target===lbOverlay||e.target===lbImg)closeLightbox()});
        // Collect article images
        var articleImgs=document.querySelectorAll('.article-content img');
        articleImgs.forEach(function(img,idx){
          lbImages.push(img);
          img.style.cursor='zoom-in';
          img.addEventListener('click',function(e){e.preventDefault();openLightbox(idx)});
        });
      }

      // ── Keyboard shortcuts panel ──
      var kbdPanel=document.getElementById('kbdPanel'),kbdClose=document.getElementById('kbdClose');
      function openKbd(){kbdPanel.classList.add('open');document.body.style.overflow='hidden'}
      function closeKbd(){kbdPanel.classList.remove('open');document.body.style.overflow=''}
      if(kbdPanel){kbdPanel.addEventListener('click',function(e){if(e.target===kbdPanel)closeKbd()});kbdClose.addEventListener('click',closeKbd)}

      // ── Global keyboard shortcuts ──
      document.addEventListener('keydown',function(e){
        var tag=e.target.tagName;
        if(tag==='INPUT'||tag==='TEXTAREA'){
          if(e.key==='Escape'){e.target.blur();closeSearch();closeLightbox()}
          return;
        }
        if(e.key==='Escape'){closeSearch();closeKbd();closeLightbox();exitImmersive()}
        if(e.key==='k'&&(e.ctrlKey||e.metaKey)){e.preventDefault();openSearch()}
        if(e.key==='/'&&document.activeElement===document.body){e.preventDefault();openSearch()}
        if(e.key==='t'&&(e.ctrlKey||e.metaKey)){e.preventDefault();document.getElementById('themeBtn')?.click()}
        if(e.key==='h'&&(e.ctrlKey||e.metaKey)){e.preventDefault();window.location.href='/'}
        if(e.key==='?'){e.preventDefault();openKbd()}
        if(e.key==='ArrowLeft'&&lbOverlay.classList.contains('open')){e.preventDefault();lbPrevFn()}
        if(e.key==='ArrowRight'&&lbOverlay.classList.contains('open')){e.preventDefault();lbNextFn()}
      });

      // ── Search ──
      var overlay=document.getElementById('searchOverlay'),input=document.getElementById('searchInput'),results=document.getElementById('searchResults');
      var searchRecent=document.getElementById('searchRecent'),searchRecentChips=document.getElementById('searchRecentChips');
      var searchSelectedIdx=-1;

      function loadRecent(){
        try{
          var recent=JSON.parse(localStorage.getItem('cosmicRecent')||'[]');
          if(!recent.length){searchRecent.style.display='none';return}
          searchRecent.style.display='block';
          searchRecentChips.innerHTML=recent.map(function(r){
            return '<button class="search-recent-chip" data-query="'+r.replace(/"/g,'&quot;')+'">'+r+'</button>';
          }).join('');
          searchRecentChips.querySelectorAll('.search-recent-chip').forEach(function(chip){
            chip.addEventListener('click',function(){
              input.value=this.dataset.query||'';
              renderResults(input.value);input.focus();
              searchRecent.style.display='none';
            });
          });
        }catch(e){}
      }
      function openSearch(){overlay.classList.add('open');input.value='';input.focus();searchSelectedIdx=-1;loadRecent();renderResults('');document.body.style.overflow='hidden'}
      function closeSearch(){overlay.classList.remove('open');document.body.style.overflow='';searchSelectedIdx=-1}
      function highlightText(text,q){
        if(!q.trim())return text;
        var re=new RegExp('('+q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')','gi');
        return text.replace(re,'<mark class="search-highlight">$1</mark>');
      }
      function renderResults(q){
        searchSelectedIdx=-1;
        if(!q.trim()){results.innerHTML='<div class="search-empty">Type to discover stars...</div>';loadRecent();return}
        searchRecent.style.display='none';
        var qq=q.toLowerCase();
        var m=sIdx.filter(function(p){
          return p.title.toLowerCase().indexOf(qq)!==-1||p.description.toLowerCase().indexOf(qq)!==-1||(p.content||'').toLowerCase().indexOf(qq)!==-1||(p.tags||[]).some(function(t){return t.toLowerCase().indexOf(qq)!==-1});
        });
        if(!m.length){
          // 42 Easter egg — only when no real results match
          if(q.trim()==='42'){
            results.innerHTML='<div class="search-empty" style="padding:24px 0"><div style="font-size:3rem;margin-bottom:8px">🐬</div><div style="font-family:var(--font-display);color:var(--star-gold);font-size:var(--text-sm);margin-bottom:4px">"Don\'t Panic."</div><div style="color:var(--text-dim);font-size:var(--text-xs)">The Answer to the Ultimate Question of Life, the Universe, and Everything.</div></div>';
          } else {
            results.innerHTML='<div class="search-empty">No celestial bodies found.</div>';
          }
          return;
        }
        results.innerHTML=m.map(function(p,i){
          var snippet='';
          var body=p.content||'';
          var idx=body.toLowerCase().indexOf(qq);
          if(idx>=0){var s=Math.max(0,idx-40),e=Math.min(body.length,idx+qq.length+40);snippet=body.slice(s,e);if(s>0)snippet='…'+snippet;if(e<body.length)snippet+='…'}
          return '<a href="/blog/'+p.id+'" class="search-result" data-index="'+i+'"><span class="search-result-date">'+new Date(p.date).toLocaleDateString('zh-CN',{month:'short',day:'numeric'})+'</span><div class="search-result-info"><div class="search-result-title">'+highlightText(p.title,q)+'</div><div class="search-result-desc">'+highlightText(p.description,q)+'</div>'+(snippet?'<div class="search-result-snippet">'+highlightText(snippet,q)+'</div>':'')+'</div><div class="search-result-tags">'+(p.tags||[]).slice(0,2).map(function(t){return '<span class="search-result-tag">'+t+'</span>'}).join('')+'</div></a>'
        }).join('');
        // Save recent search
        try{var recent=JSON.parse(localStorage.getItem('cosmicRecent')||'[]');recent=recent.filter(function(r){return r!==q});recent.unshift(q);recent=recent.slice(0,5);localStorage.setItem('cosmicRecent',JSON.stringify(recent))}catch(e){}
      }
      // Keyboard navigation in search
      input.addEventListener('keydown',function(e){
        var items=results.querySelectorAll('.search-result');
        if(e.key==='ArrowDown'){e.preventDefault();searchSelectedIdx=Math.min(searchSelectedIdx+1,items.length-1);updateSearchSelection(items)}
        else if(e.key==='ArrowUp'){e.preventDefault();searchSelectedIdx=Math.max(searchSelectedIdx-1,-1);updateSearchSelection(items)}
        else if(e.key==='Enter'){
          if(searchSelectedIdx>=0&&items[searchSelectedIdx]){
            e.preventDefault();var href=items[searchSelectedIdx].getAttribute('href');
            if(href)window.location.href=href;
          }
        }
      });
      function updateSearchSelection(items){
        items.forEach(function(item,i){
          if(i===searchSelectedIdx){item.classList.add('search-selected');item.focus()}else{item.classList.remove('search-selected')}
        });
      }
      document.getElementById('searchBtn').addEventListener('click',openSearch);
      overlay.addEventListener('click',function(e){if(e.target===overlay)closeSearch()});
      input.addEventListener('input',function(){renderResults(input.value)});
    })();
  </script>
</body>
</html>
