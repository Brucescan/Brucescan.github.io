---
import { site } from "../data/site";
import { getCollection } from "astro:content";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const pageDesc = description ?? site.description;
const pageUrl = new URL(Astro.url.pathname, site.url).href;
const ogImg = ogImage ? new URL(ogImage, site.url).href : new URL("/images/og.jpg", site.url).href;

const allPosts2 = await getCollection("blog");
const tagSet = new Set<string>();
for (const p of allPosts2) for (const t of p.data.tags) tagSet.add(t);
const firstTag = Array.from(tagSet).sort()[0]?.toLowerCase() ?? '';
const searchData = allPosts2.map(p => ({
  id: p.id, title: p.data.title, description: p.data.description,
  date: p.data.date.toISOString(),
}));

const currentPath = Astro.url.pathname;
function isActive(href:string){if(href==='/')return currentPath==='/';return currentPath.startsWith(href)}
---

<!doctype html>
<html lang={site.lang} data-theme="dark">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content={pageDesc}><meta name="generator" content={Astro.generator}>
  <title>{pageTitle}</title>
  <link rel="canonical" href={pageUrl}>
  <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml">
  <meta property="og:title" content={pageTitle}><meta property="og:description" content={pageDesc}>
  <meta property="og:type" content="website"><meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={ogImg}><meta property="og:site_name" content={site.title}>
  <meta property="og:locale" content={site.lang}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}><meta name="twitter:description" content={pageDesc}>
  <meta name="twitter:image" content={ogImg}>
  <script is:inline>(function(){var s=localStorage.getItem("theme");document.documentElement.setAttribute("data-theme",s||"dark")})()</script>
</head>
<body>
  <!-- Cosmic Background -->
  <div class="cosmic-bg" aria-hidden="true"></div>
  <!-- Meteor canvas -->
  <canvas id="meteorCanvas" aria-hidden="true" style="position:fixed;inset:0;pointer-events:none;z-index:1"></canvas>

  <!-- Header -->
  <header class="cosmic-header">
    <div class="cosmic-header-inner">
      <a href="/" class="cosmic-logo">
        <div class="cosmic-logo-dot"></div>
        {site.title}
      </a>
      <button class="hamburger" id="hamburger" aria-label="Menu">☰</button>
      <nav class="cosmic-nav" id="cosmicNav">
        <a href="/" class:list={[{active:isActive('/')}]}>Home</a>
        <a href={`/blog/${searchData[0]?.id ?? ''}`} class:list={[{active:isActive('/blog')}]}>Scrolls</a>
        <a href={`/tags/${firstTag}`} class:list={[{active:isActive('/tags')}]}>Constellations</a>
        <a href="https://github.com/brucescan" target="_blank" rel="noopener">GitHub</a>
      </nav>
      <div class="cosmic-tools">
        <button class="cosmic-tool-btn" id="searchBtn" title="Search (Ctrl+K)" aria-label="Search">🔭</button>
        <button class="cosmic-tool-btn" id="themeBtn" title="Toggle theme" aria-label="Theme">☀</button>
      </div>
    </div>
  </header>

  <!-- Reading progress bar -->
  <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>

  <!-- Page Content -->
  <slot />

  <!-- Back to top -->
  <button class="back-to-top" id="backToTop" aria-label="Back to top" title="Back to top">↑</button>

  <!-- Keyboard shortcuts panel -->
  <div class="kbd-panel-overlay" id="kbdPanel">
    <div class="kbd-panel">
      <div class="kbd-panel-title">⌨ Shortcuts</div>
      <div class="kbd-row"><span class="kbd-label">Search</span><span class="kbd-keys"><kbd class="kbd-key">Ctrl</kbd>+<kbd class="kbd-key">K</kbd></span></div>
      <div class="kbd-row"><span class="kbd-label">Quick search</span><span class="kbd-keys"><kbd class="kbd-key">/</kbd></span></div>
      <div class="kbd-row"><span class="kbd-label">Toggle theme</span><span class="kbd-keys"><kbd class="kbd-key">Ctrl</kbd>+<kbd class="kbd-key">T</kbd></span></div>
      <div class="kbd-row"><span class="kbd-label">Go home</span><span class="kbd-keys"><kbd class="kbd-key">Ctrl</kbd>+<kbd class="kbd-key">H</kbd></span></div>
      <div class="kbd-row"><span class="kbd-label">Show shortcuts</span><span class="kbd-keys"><kbd class="kbd-key">?</kbd></span></div>
      <button class="kbd-close" id="kbdClose">Press ESC or click to close</button>
    </div>
  </div>

  <!-- Footer -->
  <footer class="cosmic-footer">
    <div class="container">
      <p style="font-family:var(--font-display);font-size:var(--text-xs);color:var(--star-gold);letter-spacing:0.1em;margin-bottom:8px">
        ✦ THE COSMIC CODEX ✦
      </p>
      <p>&copy; {new Date().getFullYear()} {site.author} &middot; Made of stardust &middot; <a href="/rss.xml">RSS</a></p>
    </div>
  </footer>

  <!-- Search overlay -->
  <div class="search-overlay" id="searchOverlay">
    <div class="search-dialog">
      <div class="search-input-wrap">
        <span class="search-icon">🔭</span>
        <input class="search-input" id="searchInput" placeholder="Search the cosmos..." autocomplete="off">
        <span class="search-hint">ESC</span>
      </div>
      <div class="search-results" id="searchResults">
        <div class="search-empty">Type to discover stars...</div>
      </div>
    </div>
  </div>

  <script type="application/json" id="searchData" set:html={JSON.stringify(searchData)}></script>

  <script>
    (function(){
      // ── Meteor Shower ──
      (function(){
        var c=document.getElementById('meteorCanvas');if(!c)return;
        var ctx=c.getContext('2d');if(!ctx)return;
        function resize(){c.width=window.innerWidth;c.height=window.innerHeight}
        resize();window.addEventListener('resize',resize);

        var meteors=[];
        var timer=0;

        function spawn(){
          var angle=-30+Math.random()*20; // -30 to -10 degrees (top-right to bottom-left)
          var rad=angle*Math.PI/180;
          var len=80+Math.random()*140;
          // Start from right side of screen, upper portion
          var x=c.width*(0.3+Math.random()*0.7);
          var y=c.height*(0.05+Math.random()*0.3);
          meteors.push({
            x:x,y:y,len:len,angle:angle,
            life:1, // 1 -> 0
            speed:0.015+Math.random()*0.03
          });
        }

        function draw(){
          ctx.clearRect(0,0,c.width,c.height);
          timer++;
          if(timer>80+Math.random()*200){timer=0;spawn()}

          for(var i=meteors.length-1;i>=0;i--){
            var m=meteors[i];
            m.life-=m.speed;
            if(m.life<=0){meteors.splice(i,1);continue}

            var rad=m.angle*Math.PI/180;
            var ex=m.x+Math.cos(rad)*m.len;
            var ey=m.y+Math.sin(rad)*m.len;

            // Fade in then out: peak at life=0.6
            var alpha=m.life<0.3?m.life/0.3:(m.life>0.7?(1-m.life)/0.3:1);
            alpha*=0.9;

            // Trail gradient: bright at head, fading to tail
            var grad=ctx.createLinearGradient(m.x,m.y,ex,ey);
            grad.addColorStop(0,'rgba(255,255,255,0)');
            grad.addColorStop(0.85,'rgba(255,240,220,'+(alpha*0.4)+')');
            grad.addColorStop(1,'rgba(255,255,255,'+alpha+')');

            ctx.strokeStyle=grad;ctx.lineWidth=2;ctx.lineCap='round';
            ctx.beginPath();ctx.moveTo(m.x,m.y);ctx.lineTo(ex,ey);ctx.stroke();

            // Head glow
            ctx.fillStyle='rgba(255,255,255,'+(alpha*0.9)+')';
            ctx.beginPath();ctx.arc(ex,ey,1.2,0,Math.PI*2);ctx.fill();
          }
          requestAnimationFrame(draw);
        }
        spawn();draw();
      })();

      // ── Search Data ──
      var sIdx=[];
      try{var rd=document.getElementById('searchData')?.textContent;if(rd)sIdx=JSON.parse(rd)}catch(e){}

      // ── Theme ──
      var themeBtn=document.getElementById('themeBtn');
      if(themeBtn){
        themeBtn.textContent=document.documentElement.getAttribute('data-theme')==='dark'?'☀':'☾';
        themeBtn.addEventListener('click',function(){
          var h=document.documentElement,n=h.getAttribute('data-theme')==='dark'?'light':'dark';
          h.setAttribute('data-theme',n);localStorage.setItem('theme',n);
          themeBtn.textContent=n==='dark'?'☀':'☾';
        });
      }

      // ── Mobile nav ──
      var ham=document.getElementById('hamburger'),nav=document.getElementById('cosmicNav');
      if(ham&&nav){ham.addEventListener('click',function(){nav.classList.toggle('open')})}

      // ── Reading progress ──
      var prog=document.getElementById('readingProgress');
      if(prog){window.addEventListener('scroll',function(){var h=document.documentElement.scrollHeight-window.innerHeight;prog.style.width=h>0?Math.min(window.scrollY/h*100,100)+'%':'0'},{passive:true})}

      // ── Back to top ──
      var btt=document.getElementById('backToTop');
      if(btt){window.addEventListener('scroll',function(){btt.classList.toggle('visible',window.scrollY>400)},{passive:true});btt.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'})})}

      // ── Code copy buttons ──
      document.querySelectorAll('pre').forEach(function(pre){var wrap=document.createElement('div');wrap.className='code-block-wrap';pre.parentNode.insertBefore(wrap,pre);wrap.appendChild(pre);var btn=document.createElement('button');btn.className='copy-btn';btn.textContent='Copy';wrap.appendChild(btn);btn.addEventListener('click',function(){var code=pre.querySelector('code')?.textContent||pre.textContent||'';navigator.clipboard.writeText(code).then(function(){btn.textContent='Copied!';btn.classList.add('copied');setTimeout(function(){btn.textContent='Copy';btn.classList.remove('copied')},2000)})})});

      // ── Keyboard shortcuts panel ──
      var kbdPanel=document.getElementById('kbdPanel'),kbdClose=document.getElementById('kbdClose');
      function openKbd(){kbdPanel.classList.add('open');document.body.style.overflow='hidden'}
      function closeKbd(){kbdPanel.classList.remove('open');document.body.style.overflow=''}
      if(kbdPanel){kbdPanel.addEventListener('click',function(e){if(e.target===kbdPanel)closeKbd()});kbdClose.addEventListener('click',closeKbd)}

      // ── Global keyboard shortcuts ──
      document.addEventListener('keydown',function(e){
        var tag=e.target.tagName;
        if(tag==='INPUT'||tag==='TEXTAREA')return;
        if(e.key==='Escape'){closeSearch();closeKbd()}
        if(e.key==='k'&&(e.ctrlKey||e.metaKey)){e.preventDefault();openSearch()}
        if(e.key==='/'&&document.activeElement===document.body){e.preventDefault();openSearch()}
        if(e.key==='t'&&(e.ctrlKey||e.metaKey)){e.preventDefault();document.getElementById('themeBtn')?.click()}
        if(e.key==='h'&&(e.ctrlKey||e.metaKey)){e.preventDefault();window.location.href='/'}
        if(e.key==='?'){e.preventDefault();openKbd()}
      });
      function openSearch(){overlay.classList.add('open');input.value='';input.focus();renderResults('');document.body.style.overflow='hidden'}
      function closeSearch(){overlay.classList.remove('open');document.body.style.overflow=''}
      function renderResults(q){
        if(!q.trim()){results.innerHTML='<div class="search-empty">Type to discover stars...</div>';return}
        var m=sIdx.filter(function(p){var t=p.title.toLowerCase(),d=p.description.toLowerCase(),qq=q.toLowerCase();return t.indexOf(qq)!==-1||d.indexOf(qq)!==-1});
        if(!m.length){results.innerHTML='<div class="search-empty">No celestial bodies found in this region.</div>';return}
        results.innerHTML=m.map(function(p){return '<a href="/blog/'+p.id+'" class="search-result"><span class="search-result-date">'+new Date(p.date).toLocaleDateString('zh-CN',{month:'short',day:'numeric'})+'</span><div class="search-result-info"><div class="search-result-title">'+p.title+'</div><div class="search-result-desc">'+p.description+'</div></div></a>'}).join('')
      }
      document.getElementById('searchBtn').addEventListener('click',openSearch);
      overlay.addEventListener('click',function(e){if(e.target===overlay)closeSearch()});
      input.addEventListener('input',function(){renderResults(input.value)});
      document.addEventListener('keydown',function(e){
        if(e.key==='Escape'&&overlay.classList.contains('open'))closeSearch();
        if(e.key==='k'&&(e.ctrlKey||e.metaKey)){e.preventDefault();openSearch()}
        if(e.key==='/'&&document.activeElement===document.body){e.preventDefault();openSearch()}
      });
    })();
  </script>
</body>
</html>
