<canvas class="pixel-stars-canvas" id="pixelStarsCanvas" aria-hidden="true"></canvas>

<script>
  (function() {
    var canvas = document.getElementById("pixelStarsCanvas");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");
    if (!ctx) return;

    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var stars = [];
    var STAR_COUNT = 80;

    function resize() {
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      canvas.style.width = window.innerWidth + "px";
      canvas.style.height = window.innerHeight + "px";
    }

    function createStars() {
      stars = [];
      for (var i = 0; i < STAR_COUNT; i++) {
        stars.push({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          size: (Math.random() > 0.9 ? 2 : 1) * dpr,
          twinkle: Math.random() * Math.PI * 2,
          speed: 0.01 + Math.random() * 0.03,
          color: Math.random() > 0.7 ? "#ffd700" : "#e8e8ff"
        });
      }
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        s.twinkle += s.speed;
        var alpha = 0.3 + Math.sin(s.twinkle) * 0.4;
        ctx.fillStyle = s.color;
        ctx.globalAlpha = alpha;
        ctx.fillRect(
          Math.round(s.x * dpr / s.size) * s.size,
          Math.round(s.y * dpr / s.size) * s.size,
          s.size, s.size
        );
      }
      ctx.globalAlpha = 1;
      requestAnimationFrame(draw);
    }

    resize();
    createStars();
    draw();

    window.addEventListener("resize", function() {
      resize();
      createStars();
    });
  })();
</script>

<style>
  .pixel-stars-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
</style>
