---
interface Props {
  title: string;
  description: string;
  date: string;
  slug: string;
  readingTime?: string;
  tags?: string[];
}

const { title, description, date, slug, readingTime, tags = [] } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString("zh-CN", {
  year: "numeric", month: "long", day: "numeric",
});

const postDate = new Date(date);
const daysAgo = Math.floor((Date.now() - postDate.getTime()) / (1000 * 60 * 60 * 24));
const isNew = daysAgo < 21;

// Assign a "rarity" based on tag count for pixel card variant
const rarity = tags.length >= 3 ? "legendary" : tags.length >= 2 ? "rare" : "common";
const rarityIcon = { legendary: "⭐", rare: "◆", common: "●" };
---

<article class={`quest-card quest-card--${rarity} reveal-stagger-item`}>
  <a href={`/blog/${slug}`} class="quest-card-link">
    <!-- Rarity indicator -->
    <div class="quest-rarity" title={`${rarity} quest`}>
      {rarityIcon[rarity]}
    </div>

    <div class="quest-card-content">
      <div class="quest-card-meta">
        <time datetime={date}>{formattedDate}</time>
        {readingTime && <span class="dot">·</span>}
        {readingTime && <span>{readingTime}</span>}
        {isNew && <span class="quest-badge">NEW!</span>}
      </div>

      <h3 class="quest-card-title">{title}</h3>
      <p class="quest-card-desc">{description}</p>

      {
        tags.length > 0 && (
          <div class="quest-card-tags">
            {tags.map((tag) => (
              <span class="quest-card-tag">#{tag}</span>
            ))}
          </div>
        )
      }

      <span class="quest-card-cta">
        ▶ Accept Quest
      </span>
    </div>
  </a>
</article>

<style>
  .quest-card {
    background: var(--color-surface);
    border: 4px solid;
    border-color: var(--color-border-bright) var(--color-border-dim) var(--color-border-dim) var(--color-border-bright);
    transition: all var(--transition-fast);
    position: relative;
    overflow: hidden;
  }

  /* Rarity variants */
  .quest-card--common {
    border-color: var(--color-border-bright) var(--color-border-dim) var(--color-border-dim) var(--color-border-bright);
  }
  .quest-card--rare {
    border-color: var(--color-mp) var(--color-mp-dim) var(--color-mp-dim) var(--color-mp);
    box-shadow: 0 0 8px rgba(68,153,255,0.1);
  }
  .quest-card--legendary {
    border-color: var(--color-gold) var(--color-gold-dim) var(--color-gold-dim) var(--color-gold);
    box-shadow: 0 0 12px rgba(255,215,0,0.1);
  }

  .quest-card:hover {
    transform: translate(-2px, -4px);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.5);
  }

  .quest-card--rare:hover {
    border-color: var(--color-mp) var(--color-mp) var(--color-mp-dim) var(--color-mp-dim);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.5), 0 0 16px rgba(68,153,255,0.15);
  }
  .quest-card--legendary:hover {
    border-color: var(--color-gold) var(--color-gold) var(--color-gold-dim) var(--color-gold-dim);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.5), 0 0 20px rgba(255,215,0,0.2);
  }

  .quest-card:active {
    transform: translate(0, 0);
    box-shadow: 2px 2px 0 rgba(0,0,0,0.3);
  }

  /* ── Rarity icon ── */
  .quest-rarity {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    font-size: 0.7rem;
    z-index: 1;
  }
  .quest-card--common .quest-rarity { color: var(--color-text-muted); }
  .quest-card--rare .quest-rarity { color: var(--color-mp); }
  .quest-card--legendary .quest-rarity { color: var(--color-gold); animation: sprite-pulse 2s steps(4) infinite; }

  /* ── Link ── */
  .quest-card-link {
    display: block;
    padding: var(--space-xl);
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .quest-card-link:hover { color: inherit; }

  .quest-card-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* ── Meta ── */
  .quest-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .dot { color: var(--color-border); }

  /* ── New badge ── */
  .quest-badge {
    font-family: var(--font-pixel);
    font-size: 0.4rem;
    color: #0b0b1f;
    background: var(--color-hp);
    padding: 2px 8px;
    border: 2px solid var(--color-hp-dim);
    animation: sprite-pulse 1.5s steps(3) infinite;
  }

  /* ── Title ── */
  .quest-card-title {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    color: var(--color-gold);
    line-height: 1.4;
    letter-spacing: 0.03em;
    text-shadow: 1px 1px 0 var(--color-gold-dim);
  }

  .quest-card--legendary .quest-card-title {
    color: var(--color-gold);
  }

  /* ── Description ── */
  .quest-card-desc {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Tags ── */
  .quest-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .quest-card-tag {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: var(--color-mp);
    padding: 2px 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-mp-dim);
  }

  /* ── CTA ── */
  .quest-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-pixel);
    font-size: var(--text-2xs);
    color: var(--color-hp);
    margin-top: var(--space-xs);
    transition: gap 0.1s steps(2);
  }

  .quest-card:hover .quest-card-cta {
    gap: 10px;
    color: var(--color-hp);
    text-shadow: 0 0 6px rgba(68,238,68,0.4);
  }
</style>
