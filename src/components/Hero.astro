---
import { site } from "../data/site";

interface Props {
  postCount?: number;
  tagCount?: number;
}

const { postCount = 0, tagCount = 0 } = Astro.props;
---

<section class="hero">
  <!-- Parallax blobs -->
  <div class="hero-blobs" id="heroBlobs" aria-hidden="true">
    <div class="hero-blob-wrapper" data-depth="0.18">
      <div class="hero-blob"></div>
    </div>
    <div class="hero-blob-wrapper" data-depth="0.10">
      <div class="hero-blob"></div>
    </div>
    <div class="hero-blob-wrapper" data-depth="0.06">
      <div class="hero-blob"></div>
    </div>
  </div>

  <div class="container hero-content">
    <div class="hero-avatar-wrapper reveal">
      <div class="hero-avatar">
        <img src="/images/avatar.jpg" alt={site.author} width="80" height="80" />
      </div>
    </div>
    <h1 class="hero-title reveal">Flazi</h1>
    <p class="hero-tagline reveal">{site.description}</p>
    <div class="hero-stats reveal">
      <span class="hero-stat"><strong id="statPosts">{postCount}</strong> articles</span>
      <span class="hero-stat-dot">·</span>
      <span class="hero-stat"><strong id="statTags">{tagCount}</strong> tags</span>
    </div>
    <div class="hero-actions reveal">
      <a href="#posts" class="btn btn-primary lggc">Read the blog</a>
      {
        site.social.github && (
          <a href={site.social.github} class="btn btn-secondary lggc" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        )
      }
    </div>
  </div>

  <!-- Scroll-down indicator -->
  <div class="scroll-indicator" id="scrollIndicator" aria-hidden="true">
    <span class="scroll-indicator-line"></span>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-4xl) 0 var(--space-3xl);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    position: relative;
    z-index: 1;
  }

  .hero-avatar-wrapper {
    margin-bottom: var(--space-md);
  }

  .hero-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    position: relative;
  }

  /* Glass ring behind avatar */
  .hero-avatar::before {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.15);
    box-shadow:
      0 0 0 4px rgba(255, 255, 255, 0.1),
      0 2px 16px rgba(0, 0, 0, 0.06);
    z-index: 0;
  }

  [data-theme="dark"] .hero-avatar::before {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
    box-shadow:
      0 0 0 4px rgba(255, 255, 255, 0.04),
      0 2px 16px rgba(0, 0, 0, 0.3);
  }

  /* Spinning accent glow */
  .hero-avatar::after {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--color-accent), transparent 35%, transparent 65%, var(--color-accent));
    opacity: 0.2;
    animation: avatarSpin 4s linear infinite;
    z-index: 0;
  }

  [data-theme="dark"] .hero-avatar::after {
    opacity: 0.3;
  }

  @keyframes avatarSpin {
    to { transform: rotate(360deg); }
  }

  .hero-avatar img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: block;
    position: relative;
    z-index: 1;
    transition: transform var(--transition-spring);
    object-fit: cover;
  }

  .hero-avatar:hover img {
    transform: scale(1.06);
  }

  .hero-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    background: linear-gradient(
      135deg,
      var(--color-text) 0%,
      var(--color-hero-gradient-end) 40%,
      var(--color-accent) 50%,
      var(--color-hero-gradient-end) 60%,
      var(--color-text) 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: titleShimmer 6s ease-in-out infinite;
  }

  @keyframes titleShimmer {
    0%, 100% { background-position: 0% center; }
    50% { background-position: 200% center; }
  }

  .hero-tagline {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    font-weight: 400;
    line-height: 1.5;
    max-width: 480px;
    letter-spacing: -0.01em;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  /* Minimal btn — lggc handles padding, radius, border, and transitions */
  .btn {
    font-size: var(--text-base);
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .btn-primary {
    --lggc-padding: 12px 28px;
    --lggc-bg: rgba(0, 0, 0, 0.85);
    color: #fff;
    font-weight: 600;
  }

  .btn-primary:hover {
    --lggc-bg: rgba(0, 0, 0, 0.92);
    color: #fff;
  }

  [data-theme="dark"] .btn-primary {
    --lggc-bg: rgba(255, 255, 255, 0.9);
    color: #000;
  }

  [data-theme="dark"] .btn-primary:hover {
    --lggc-bg: rgba(255, 255, 255, 0.95);
    color: #000;
  }

  .btn-secondary {
    --lggc-padding: 12px 28px;
    --lggc-bg: rgba(255, 255, 255, 0.6);
    color: var(--color-text);
    font-weight: 500;
  }

  .btn-secondary:hover {
    --lggc-bg: rgba(255, 255, 255, 0.75);
  }

  [data-theme="dark"] .btn-secondary {
    --lggc-bg: rgba(255, 255, 255, 0.1);
  }

  [data-theme="dark"] .btn-secondary:hover {
    --lggc-bg: rgba(255, 255, 255, 0.16);
  }

  /* Hero stats */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .hero-stat strong {
    color: var(--color-text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .hero-stat-dot {
    color: var(--color-text-tertiary);
  }

  /* Scroll-down indicator */
  .scroll-indicator {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .scroll-indicator.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .scroll-indicator-line {
    display: block;
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, var(--color-text-tertiary), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  .scroll-indicator::after {
    content: "";
    display: block;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid var(--color-text-tertiary);
    border-bottom: 1.5px solid var(--color-text-tertiary);
    transform: rotate(45deg);
    animation: scrollChevron 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.1); }
  }

  @keyframes scrollChevron {
    0%, 100% { opacity: 0.3; transform: rotate(45deg) translateY(0); }
    50% { opacity: 1; transform: rotate(45deg) translateY(4px); }
  }
</style>

<script>
  (function() {
    // Parallax blobs
    var hero = document.querySelector(".hero");
    var wrappers = document.querySelectorAll(".hero-blob-wrapper");
    if (hero && wrappers.length > 0) {
      var maxOffset = 50;
      hero.addEventListener("mousemove", function(e) {
        var rect = hero.getBoundingClientRect();
        var x = (e.clientX - rect.left) / rect.width - 0.5;
        var y = (e.clientY - rect.top) / rect.height - 0.5;
        wrappers.forEach(function(w) {
          var depth = parseFloat(w.getAttribute("data-depth")) || 0.1;
          w.style.transition = "none";
          w.style.transform = "translate(" + (x * maxOffset * depth * 2) + "px, " + (y * maxOffset * depth * 2) + "px)";
        });
      });
      hero.addEventListener("mouseleave", function() {
        wrappers.forEach(function(w) {
          w.style.transition = "";
          w.style.transform = "";
        });
      });
    }

    // Scroll indicator fade
    var indicator = document.getElementById("scrollIndicator");
    if (indicator) {
      window.addEventListener("scroll", function() {
        indicator.classList.toggle("hidden", window.scrollY > 100);
      }, { passive: true });
    }

    // Animated count-up for stats
    var statPosts = document.getElementById("statPosts");
    var statTags = document.getElementById("statTags");
    if (statPosts || statTags) {
      function animateCount(el, target, duration) {
        if (!el) return;
        var start = 0;
        var startTime = performance.now();
        function step(now) {
          var progress = Math.min((now - startTime) / duration, 1);
          // Ease-out cubic
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target);
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = target;
        }
        requestAnimationFrame(step);
      }
      // Delay until reveal animation completes (~700ms)
      setTimeout(function() {
        animateCount(statPosts, parseInt(statPosts.textContent) || 0, 1000);
        animateCount(statTags, parseInt(statTags.textContent) || 0, 1200);
      }, 800);
    }
  })();
</script>
