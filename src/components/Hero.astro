---
import { site } from "../data/site";

interface Props {
  postCount?: number;
  tagCount?: number;
}

const { postCount = 0, tagCount = 0 } = Astro.props;
---

<section class="hero">
  <div class="container hero-content">
    <!-- Character portrait frame -->
    <div class="hero-portrait-wrap reveal">
      <div class="hero-portrait">
        <img src="/images/avatar.jpg" alt={site.author} width="80" height="80" />
      </div>
    </div>

    <!-- Name + title -->
    <div class="hero-info reveal">
      <h1 class="hero-name">{site.author}</h1>
      <p class="hero-class">Code Wizard Lv.99</p>
    </div>

    <!-- Stat bars -->
    <div class="hero-stats reveal">
      <div class="stat-bar">
        <span class="stat-label">HP</span>
        <div class="stat-bar__track">
          <div class="stat-bar__fill stat-bar__fill--hp" style="width:100%"></div>
        </div>
        <span class="stat-value">999 / 999</span>
      </div>
      <div class="stat-bar">
        <span class="stat-label">MP</span>
        <div class="stat-bar__track">
          <div class="stat-bar__fill stat-bar__fill--mp" style="width:75%"></div>
        </div>
        <span class="stat-value">750 / 999</span>
      </div>
      <div class="stat-bar">
        <span class="stat-label">EXP</span>
        <div class="stat-bar__track">
          <div class="stat-bar__fill stat-bar__fill--xp" style="width:45%"></div>
        </div>
        <span class="stat-value">4500 / 9999</span>
      </div>
    </div>

    <!-- Stats line -->
    <div class="hero-meta reveal">
      <span class="hero-meta-item">
        <span class="meta-icon">📜</span>
        <strong id="statPosts">{postCount}</strong> quests completed
      </span>
      <span class="hero-meta-dot"></span>
      <span class="hero-meta-item">
        <span class="meta-icon">🏷</span>
        <strong id="statTags">{tagCount}</strong> spell schools
      </span>
    </div>

    <!-- Actions -->
    <div class="hero-actions reveal">
      <a href="#posts" class="pixel-btn pixel-btn--primary">
        ▶ Read the Quest Log
      </a>
      {
        site.social.github && (
          <a href={site.social.github} class="pixel-btn" target="_blank" rel="noopener noreferrer">
            ⚔ GitHub
          </a>
        )
      }
    </div>
  </div>

  <!-- Pixel floor -->
  <div class="hero-floor" aria-hidden="true">
    <div class="hero-floor-line"></div>
  </div>
</section>

<script>
  (function() {
    // Animated count-up for stats
    var statPosts = document.getElementById("statPosts");
    var statTags = document.getElementById("statTags");
    if (statPosts || statTags) {
      function animateCount(el, target, duration) {
        if (!el) return;
        var start = 0;
        var startTime = performance.now();
        function step(now) {
          var progress = Math.min((now - startTime) / duration, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target);
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = target;
        }
        requestAnimationFrame(step);
      }
      setTimeout(function() {
        animateCount(statPosts, parseInt(statPosts.textContent) || 0, 800);
        animateCount(statTags, parseInt(statTags.textContent) || 0, 1000);
      }, 600);
    }
  })();
</script>

<style>
  .hero {
    padding: var(--space-3xl) 0 var(--space-2xl);
    text-align: center;
    position: relative;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    position: relative;
    z-index: 1;
  }

  /* ── Portrait ── */
  .hero-portrait-wrap {
    margin-bottom: var(--space-sm);
  }

  .hero-portrait {
    width: 88px; height: 88px;
    position: relative;
  }

  /* Pixel frame around avatar */
  .hero-portrait::before {
    content: '';
    position: absolute;
    inset: -6px;
    background: var(--color-border);
    clip-path: polygon(
      0px 4px, 4px 4px, 4px 0px, calc(100% - 4px) 0px,
      calc(100% - 4px) 4px, 100% 4px, 100% calc(100% - 4px),
      calc(100% - 4px) calc(100% - 4px), calc(100% - 4px) 100%,
      4px 100%, 4px calc(100% - 4px), 0px calc(100% - 4px)
    );
    z-index: 0;
  }

  .hero-portrait img {
    width: 80px; height: 80px;
    position: relative;
    z-index: 1;
    image-rendering: pixelated;
    border: 3px solid var(--color-border-bright);
  }

  .hero-portrait:hover img {
    animation: sprite-pulse 0.3s steps(3) 1;
  }

  /* ── Name & class ── */
  .hero-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .hero-name {
    font-family: var(--font-pixel);
    font-size: var(--text-2xl);
    color: var(--color-gold);
    text-shadow:
      3px 3px 0 var(--color-gold-dim),
      0 0 12px rgba(255,215,0,0.2);
    letter-spacing: 0.08em;
  }

  .hero-class {
    font-family: var(--font-pixel);
    font-size: var(--text-2xs);
    color: var(--color-mp);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-shadow: 0 0 6px rgba(68,153,255,0.3);
  }

  /* ── Stat bars ── */
  .hero-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    width: 100%;
    max-width: 420px;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-bg-alt);
    border: 3px solid var(--color-border-dim);
  }

  .stat-label {
    font-family: var(--font-pixel);
    font-size: var(--text-2xs);
    width: 32px;
    text-align: right;
    flex-shrink: 0;
  }
  .stat-label { color: var(--color-hp); }
  .stat-bar:nth-child(2) .stat-label { color: var(--color-mp); }
  .stat-bar:nth-child(3) .stat-label { color: var(--color-xp); }

  .stat-value {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: var(--color-text-dim);
    width: 80px;
    text-align: right;
    flex-shrink: 0;
  }

  /* ── Meta ── */
  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-pixel);
    font-size: var(--text-2xs);
    color: var(--color-text-dim);
  }

  .hero-meta-item {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .meta-icon { font-size: 0.7rem; }

  .hero-meta-item strong {
    color: var(--color-gold);
  }

  .hero-meta-dot {
    width: 3px; height: 3px;
    background: var(--color-border);
  }

  /* ── Actions ── */
  .hero-actions {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ── Floor ── */
  .hero-floor {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 20px;
    overflow: hidden;
  }

  .hero-floor-line {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 4px;
    background: var(--color-border-bright);
    box-shadow: 0 -4px 0 var(--color-border-dim);
  }

  .hero-floor-line::after {
    content: '';
    position: absolute;
    bottom: 4px; left: 10%;
    width: 80%;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-gold-dim) 0px,
      var(--color-gold-dim) 20px,
      transparent 20px,
      transparent 24px
    );
  }

  @media (max-width: 768px) {
    .hero-stats {
      max-width: 100%;
    }
    .hero-name {
      font-size: var(--text-xl);
    }
  }
</style>
