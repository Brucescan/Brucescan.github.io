<div
  class="bilibili-banner"
  id="bilibiliBanner"
  aria-hidden="true"
>
  <div class="bilibili-layer"><img src="/images/bilibili/bg.png" width="3000" height="250" alt="" /></div>
  <div class="bilibili-layer"><img src="/images/bilibili/girl1.png" width="3000" height="275" alt="" id="girlImg" /></div>
  <div class="bilibili-layer"><img src="/images/bilibili/grassland.png" width="3000" height="250" alt="" /></div>
  <div class="bilibili-layer"><img src="/images/bilibili/mushroom.png" width="3000" height="250" alt="" /></div>
  <div class="bilibili-layer"><img src="/images/bilibili/spirit.png" width="3000" height="275" alt="" /></div>
  <div class="bilibili-layer"><img src="/images/bilibili/leaf.png" width="3000" height="275" alt="" /></div>
</div>

<script>
  (function() {
    var banner = document.getElementById("bilibiliBanner");
    var layers = document.querySelectorAll(".bilibili-layer");
    if (!banner || layers.length === 0) return;

    var x = 0;
    var x_new = 0;
    var x_offset = 0;

    var window_width = document.documentElement.clientWidth;
    var step = window_width / 2 / 5;

    var data_images = [
      { x: 0, b: 4 },
      { x: 0, b: 0 },
      { x: 0, b: 1 },
      { x: 0, b: 4 },
      { x: 0, b: 5 },
      { x: 0, b: 6 },
    ];

    function init() {
      for (var i = 0; i < layers.length; i++) {
        var el = layers[i];
        var d = data_images[i];
        el.children[0].style.cssText =
          "transition: .2s linear; transform: translate(" + d.x + "px); filter: blur(" + d.b + "px);";
      }
    }

    banner.addEventListener("mouseover", function(e) {
      x = e.clientX;
    });

    banner.addEventListener("mousemove", function(e) {
      x_new = e.clientX;
      x_offset = x - x_new;
      for (var i = 0; i < layers.length; i++) {
        var level = (6 - i) * 10;
        var el = layers[i];
        var d = data_images[i];
        var b_new = Math.abs(d.b + (x_offset / step));
        var l_new = 0 - (x_offset / level);
        el.children[0].style.cssText =
          "transform: translate(" + l_new + "px); filter: blur(" + b_new + "px);";
      }
    });

    banner.addEventListener("mouseout", function() {
      init();
    });

    window.addEventListener("resize", function() {
      window_width = document.documentElement.clientWidth;
      step = window_width / 2 / 5;
    });

    var girlImg = document.getElementById("girlImg");
    var blink_index = 0;
    var blink_timeout = 4000;

    function blink() {
      if (blink_index === 4) {
        blink_index = 1;
        blink_timeout = 4000;
      } else {
        blink_index += 1;
        blink_timeout = 30;
      }
      if (girlImg) {
        girlImg.src = "/images/bilibili/girl" + blink_index + ".png";
      }
      setTimeout(blink, blink_timeout);
    }

    init();
    blink();
  })();
</script>

<style>
  .bilibili-banner {
    position: relative;
    width: 100vw;
    height: 155px;
    overflow: hidden;
    cursor: default;
    margin: var(--space-2xl) 0;
    background: linear-gradient(
      180deg,
      #d6aa6a 0%,
      #cf9a5e 30%,
      #c8774b 70%,
      #b85a3d 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 15%,
      black 85%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 15%,
      black 85%,
      transparent 100%
    );
  }

  .bilibili-layer {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bilibili-layer img {
    display: block;
    flex-shrink: 0;
    /* No sizing constraints — images display at HTML width/height attributes,
       centered and overflow natural, clipped by banner overflow:hidden */
  }

  @media (max-width: 768px) {
    .bilibili-banner {
      height: 100px;
      margin: var(--space-xl) 0;
    }
  }
</style>
