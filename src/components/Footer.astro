---
import { site } from "../data/site";
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-icon">⚔</span>
        <span>{site.title}</span>
      </div>
      <div class="footer-links">
        {
          site.social.github && (
            <a href={site.social.github} target="_blank" rel="noopener noreferrer" class="footer-link">
              GitHub
            </a>
          )
        }
        <a href="/" class="footer-link">Home</a>
        <a href="/#posts" class="footer-link">Quest Log</a>
        <a href="/rss.xml" class="footer-link footer-link--rss">RSS Feed</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {new Date().getFullYear()} {site.author}. All rights reserved.
      </p>
      <p class="footer-tagline">Thanks for playing!</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-2xl) 0 var(--space-xl);
    border-top: 4px solid var(--color-border-bright);
    background: var(--color-surface);
    margin-top: var(--space-3xl);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-pixel);
    font-size: var(--text-2xs);
    color: var(--color-gold);
  }

  .footer-icon {
    font-size: 1rem;
    animation: sprite-bob 2s steps(4) infinite;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .footer-link {
    font-family: var(--font-pixel);
    font-size: var(--text-2xs);
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color var(--transition-fast);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .footer-link:hover { color: var(--color-gold); }

  .footer-link--rss {
    color: var(--color-warning);
  }
  .footer-link--rss:hover { color: var(--color-hp); }

  .footer-bottom {
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-border-dim);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-tagline {
    font-family: var(--font-pixel);
    font-size: var(--text-2xs);
    color: var(--color-text-dim);
    margin: 0;
  }

  @media (max-width: 480px) {
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
    .footer-bottom {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>
