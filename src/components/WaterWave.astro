---
interface Props {
  height?: number;
  rows?: number;
  intensity?: number;
}

const h = Astro.props.height ?? 90;
const rowCount = Astro.props.rows ?? 4;
const waveIntensity = Math.max(0.3, Math.min(2, Astro.props.intensity ?? 1));
---

<div class="waterwave-section" style={`height:${h}px`} aria-hidden="true">
  <canvas class="waterwave-canvas" data-height={h} data-rows={rowCount} data-intensity={waveIntensity}></canvas>
</div>

<script>
  (function() {
    var canvases = document.querySelectorAll(".waterwave-canvas");
    if (canvases.length === 0) return;

    canvases.forEach(function(canvas) {
      var ctx = canvas.getContext("2d");
      if (!ctx) return;

      var animId = null;
      var time = Math.random() * 100; // random start phase so instances aren't in sync
      var h = parseInt(canvas.getAttribute("data-height")) || 90;
      var rowCount = parseInt(canvas.getAttribute("data-rows")) || 4;
      var intensity = parseFloat(canvas.getAttribute("data-intensity")) || 1;

      var chars = ["▲", "▼"];
      var dpr = Math.min(window.devicePixelRatio || 1, 2);

      function resize() {
        var w = window.innerWidth;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        canvas.style.width = w + "px";
        canvas.style.height = h + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function buildRows() {
        var rows = [];
        var gap = (h - 10) / rowCount;
        for (var r = 0; r < rowCount; r++) {
          rows.push({
            y: 12 + r * gap,
            speed: (0.5 + Math.random() * 0.4) * intensity,
            amp: (6 + Math.random() * 6) * intensity,
            phase: Math.random() * Math.PI * 2,
            freq: 0.02 + Math.random() * 0.015,
          });
        }
        return rows;
      }

      var rows = buildRows();

      function draw() {
        var w = window.innerWidth;
        var isDark = document.documentElement.getAttribute("data-theme") === "dark";

        ctx.clearRect(0, 0, w, h);

        var fontSize = 13 + intensity * 2;
        var charW = 20 + intensity * 2;
        ctx.font = fontSize + "px sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";

        for (var r = 0; r < rows.length; r++) {
          var row = rows[r];
          var cols = Math.ceil(w / charW) + 2;

          for (var c = 0; c < cols; c++) {
            var x = c * charW;
            var phaseOffset = c * row.freq * charW;
            var dy = Math.sin(time * row.speed + phaseOffset + row.phase) * row.amp;

            // Edge fade
            var fade = 1;
            var fadeStart = 100;
            if (x < fadeStart) fade = x / fadeStart;
            if (x > w - fadeStart) fade = Math.min(fade, (w - x) / fadeStart);
            fade = Math.max(0, Math.min(1, fade));

            var waveAlpha = Math.abs(Math.sin(time * row.speed + phaseOffset + row.phase));
            var alpha = (0.08 + waveAlpha * 0.1) * fade;
            ctx.fillStyle = isDark
              ? "rgba(255,255,255," + alpha + ")"
              : "rgba(0,0,0," + alpha + ")";

            ctx.fillText(chars[c % 2], x, row.y + dy);
          }
        }

        time += 0.016;
        animId = requestAnimationFrame(draw);
      }

      resize();
      draw();

      window.addEventListener("resize", resize);

      // Pause when off-screen
      var observer = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) {
          if (!animId) { animId = requestAnimationFrame(draw); }
        } else {
          if (animId) { cancelAnimationFrame(animId); animId = null; }
        }
      }, { threshold: 0 });
      observer.observe(canvas);
    });
  })();
</script>

<style>
  .waterwave-section {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    overflow: hidden;
    line-height: 0;
  }

  .waterwave-canvas {
    display: block;
  }
</style>
