---
interface Props {
  tags: { name: string; count: number }[];
  activeTag: string;
}

const { tags, activeTag } = Astro.props;
---

<div class="tags-bar">
  <a href="/#posts" class:list={["tag-pill", { active: activeTag === "" }]}>
    ALL
  </a>
  {tags.map((t) => (
    <a
      href={`/tags/${t.name.toLowerCase()}`}
      class:list={["tag-pill", { active: activeTag === t.name }]}
    >
      {t.name}
      <span class="count">x{t.count}</span>
    </a>
  ))}
</div>
