---
import { site } from '../data/site';
import { path } from '../lib/urls';
const current = Astro.url.pathname;
const links = [['', '首页'], ['posts/', '文章'], ['about/', '关于']];
---
<a class="skip-link" href="#main">跳到正文</a>
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={path()}>{site.name}</a>
    <nav aria-label="主导航">
      {links.map(([url,label]) => <a href={path(url)} aria-current={(url ? current.startsWith(path(url)) : current === path()) ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
