---
import { site } from "../data/site";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  if (href === "/#posts") return currentPath.startsWith("/blog") || currentPath.startsWith("/tags");
  if (href === "/#about") return false;
  return currentPath === href;
}
---

<header class="header">
  <div class="header-inner container">
    <a href="/" class="logo" aria-label="Home">
      <span class="logo-icon">⚔</span>
      <span class="logo-text">FLAZI</span>
      <span class="logo-lv">Lv.99</span>
    </a>

    <div class="header-actions">
      <nav class="nav" aria-label="Main navigation">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              data-nav={item.label.toLowerCase()}
              class:list={["nav-link", { active: isActive(item.href) }]}
            >
              <span class="nav-cursor" aria-hidden="true">▶</span>
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="header-tools">
        <!-- Search trigger -->
        <button class="search-trigger" id="searchTrigger" aria-label="Search">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="7" cy="7" r="4.5"/>
            <path d="M10.5 10.5L14 14" stroke-linecap="square"/>
          </svg>
          <span class="shortcut-label">Search</span>
          <span class="shortcut">⌘K</span>
        </button>

        <!-- Theme toggle -->
        <button class="theme-toggle" id="themeToggle" aria-label="Toggle light mode" title="Toggle light/dark mode">
          <span class="theme-icon-dark">☀</span>
          <span class="theme-icon-light">☾</span>
        </button>

        <!-- Mobile menu -->
        <button class="hamburger-btn" id="hamburgerBtn" aria-label="Menu" aria-expanded="false">
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile nav overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay" aria-hidden="true"></div>
<nav class="mobile-nav-panel" id="mobileNavPanel" aria-label="Mobile navigation">
  {
    site.nav.map((item) => (
      <a
        href={item.href}
        class:list={["mobile-nav-link", { active: currentPath === item.href }]}
      >
        ▶ {item.label}
      </a>
    ))
  }
</nav>

<script>
  (function() {
    var btn = document.getElementById("hamburgerBtn");
    var overlay = document.getElementById("mobileNavOverlay");
    var panel = document.getElementById("mobileNavPanel");
    var isOpen = false;

    function open() {
      if (!btn || !overlay || !panel) return;
      isOpen = true;
      btn.classList.add("open");
      btn.setAttribute("aria-expanded", "true");
      overlay.classList.add("active");
      overlay.setAttribute("aria-hidden", "false");
      panel.classList.add("active");
      document.body.style.overflow = "hidden";
    }

    function close() {
      if (!btn || !overlay || !panel) return;
      isOpen = false;
      btn.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
      overlay.classList.remove("active");
      overlay.setAttribute("aria-hidden", "true");
      panel.classList.remove("active");
      document.body.style.overflow = "";
    }

    if (btn && overlay && panel) {
      btn.addEventListener("click", function() { isOpen ? close() : open(); });
      overlay.addEventListener("click", close);
      document.addEventListener("keydown", function(e) {
        if (e.key === "Escape" && isOpen) close();
      });
      panel.querySelectorAll("a").forEach(function(link) {
        link.addEventListener("click", close);
      });
    }

    // Scroll-spy for homepage nav
    var postsSection = document.getElementById("posts");
    var aboutSection = document.getElementById("about");
    if (postsSection || aboutSection) {
      var navLinks = document.querySelectorAll("[data-nav]");
      function updateNav() {
        var scrollY = window.scrollY + 80;
        var active = "home";
        if (aboutSection && scrollY >= aboutSection.offsetTop) {
          active = "about";
        } else if (postsSection && scrollY >= postsSection.offsetTop) {
          active = "blog";
        }
        navLinks.forEach(function(link) {
          var navName = link.getAttribute("data-nav");
          link.classList.toggle("active", navName === active);
        });
      }
      window.addEventListener("scroll", updateNav, { passive: true });
      updateNav();
    }
  })();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: 4px solid var(--color-border-bright);
    height: var(--header-height);
    display: flex;
    align-items: center;
    box-shadow: 0 4px 0 rgba(0,0,0,0.3);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* ── Logo ── */
  .logo {
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    flex-shrink: 0;
    color: var(--color-gold);
  }
  .logo:hover { color: var(--color-hp); }

  .logo-icon {
    font-size: 1.2rem;
    animation: sprite-bob 2s steps(4) infinite;
  }

  .logo-text {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: inherit;
    letter-spacing: 0.08em;
  }

  .logo-lv {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: var(--color-mp);
    background: var(--color-bg);
    padding: 2px 6px;
    border: 1px solid var(--color-mp-dim);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /* ── Navigation ── */
  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-link {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--color-text-dim);
    text-decoration: none;
    padding: 6px 12px;
    border: 2px solid transparent;
    transition: all var(--transition-fast);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    position: relative;
  }

  .nav-cursor {
    opacity: 0;
    font-size: 0.4rem;
    margin-right: 2px;
  }

  .nav-link:hover {
    color: var(--color-gold);
    background: var(--color-surface-hover);
    border-color: var(--color-border-dim);
  }

  .nav-link.active {
    color: var(--color-gold);
    border-color: var(--color-border-bright);
    background: var(--color-bg-alt);
  }
  .nav-link.active .nav-cursor {
    opacity: 1;
    animation: cursor-blink 1s steps(2) infinite;
  }

  /* ── Header tools ── */
  .header-tools {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .search-trigger {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: var(--color-text-dim);
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border-dim);
    padding: 6px 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all var(--transition-fast);
    text-transform: uppercase;
  }
  .search-trigger:hover {
    color: var(--color-gold);
    border-color: var(--color-gold);
  }
  .search-trigger svg { width: 14px; height: 14px; flex-shrink: 0; }
  .search-trigger .shortcut {
    font-family: var(--font-pixel);
    font-size: 0.4rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-dim);
    padding: 1px 4px;
  }

  /* ── Theme toggle ── */
  .theme-toggle {
    width: 36px; height: 36px;
    font-size: 1.1rem;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    line-height: 1;
  }
  .theme-toggle:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  .theme-icon-dark { display: block; }
  .theme-icon-light { display: none; }
  [data-theme="light"] .theme-icon-dark { display: none; }
  [data-theme="light"] .theme-icon-light { display: block; }

  @media (max-width: 768px) {
    .nav { display: none; }
    .search-trigger .shortcut-label { display: none; }
    .search-trigger .shortcut { display: none; }
    .search-trigger { padding: 8px; }
  }

  @media (max-width: 480px) {
    .logo-lv { display: none; }
  }
</style>
