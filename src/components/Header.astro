---
import { site } from "../data/site";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  if (href === "/#posts") return currentPath.startsWith("/blog") || currentPath.startsWith("/tags");
  if (href === "/#about") return false; // scroll-spy only on homepage
  return currentPath === href;
}
---

<header class="header">
  <div class="header-inner container">
    <a href="/" class="logo">
      <span class="logo-text">Brucescan</span>
    </a>

    <div class="header-actions">
      <nav class="nav" aria-label="Main navigation">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              data-nav={item.label.toLowerCase()}
              class:list={["nav-link lggc", { active: isActive(item.href) }]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="header-tools">
        <button class="search-trigger lggc" id="searchTrigger" aria-label="Search">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="7" cy="7" r="4.5"/>
            <path d="M10.5 10.5L14 14" stroke-linecap="round"/>
          </svg>
          <span class="shortcut-label">Search</span>
          <span class="shortcut">⌘K</span>
        </button>

        <button class="theme-toggle lggc" id="themeToggle" aria-label="Toggle dark mode">
          <svg class="icon-sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="8" cy="8" r="3.5"/>
            <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" stroke-linecap="round"/>
          </svg>
          <svg class="icon-moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M13.5 10.5A6 6 0 015.5 2.5 6 6 0 1013.5 10.5z" stroke-linejoin="round"/>
          </svg>
        </button>

        <button class="hamburger-btn lggc" id="hamburgerBtn" aria-label="Menu" aria-expanded="false">
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile nav overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay" aria-hidden="true"></div>
<nav class="mobile-nav-panel" id="mobileNavPanel" aria-label="Mobile navigation">
  {
    site.nav.map((item) => (
      <a
        href={item.href}
        class:list={["mobile-nav-link", { active: currentPath === item.href }]}
      >
        {item.label}
      </a>
    ))
  }
</nav>

<script>
  (function() {
    // Mobile nav
    var btn = document.getElementById("hamburgerBtn");
    var overlay = document.getElementById("mobileNavOverlay");
    var panel = document.getElementById("mobileNavPanel");

    var isOpen = false;

    function open() {
      if (!btn || !overlay || !panel) return;
      isOpen = true;
      btn.classList.add("open");
      btn.setAttribute("aria-expanded", "true");
      overlay.classList.add("active");
      overlay.setAttribute("aria-hidden", "false");
      panel.classList.add("active");
      document.body.style.overflow = "hidden";
    }

    function close() {
      if (!btn || !overlay || !panel) return;
      isOpen = false;
      btn.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
      overlay.classList.remove("active");
      overlay.setAttribute("aria-hidden", "true");
      panel.classList.remove("active");
      document.body.style.overflow = "";
    }

    if (btn && overlay && panel) {
      btn.addEventListener("click", function() {
        isOpen ? close() : open();
      });
      overlay.addEventListener("click", close);
      document.addEventListener("keydown", function(e) {
        if (e.key === "Escape" && isOpen) close();
      });
      panel.querySelectorAll("a").forEach(function(link) {
        link.addEventListener("click", close);
      });
    }

    // Scroll-spy for homepage nav (/#posts, /#about)
    var postsSection = document.getElementById("posts");
    var aboutSection = document.getElementById("about");
    if (postsSection || aboutSection) {
      var navLinks = document.querySelectorAll("[data-nav]");
      function updateNav() {
        var scrollY = window.scrollY + 80; // offset for header
        var active = "home";

        if (aboutSection && scrollY >= aboutSection.offsetTop) {
          active = "about";
        } else if (postsSection && scrollY >= postsSection.offsetTop) {
          active = "blog";
        }

        navLinks.forEach(function(link) {
          var navName = link.getAttribute("data-nav");
          link.classList.toggle("active", navName === active);
        });
      }
      window.addEventListener("scroll", updateNav, { passive: true });
      updateNav();
    }
  })();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-header-bg);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--color-border);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: opacity var(--transition-fast);
    flex-shrink: 0;
  }

  .logo:hover {
    opacity: 0.8;
    color: var(--color-text);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .nav-link {
    --lggc-padding: 6px 14px;
    --lggc-radius: 980px;
    --lggc-blur: 4px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    min-width: auto;
    min-height: auto;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link.active {
    --lggc-bg: rgba(0, 0, 0, 0.06);
    color: var(--color-text);
  }

  [data-theme="dark"] .nav-link.active {
    --lggc-bg: rgba(255, 255, 255, 0.1);
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  @media (max-width: 768px) {
    .nav {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .search-trigger .shortcut-label {
      display: none;
    }

    .search-trigger .shortcut {
      display: none;
    }

    .search-trigger {
      padding: var(--space-xs);
      border-radius: 50%;
      width: 32px;
      height: 32px;
    }

    .search-trigger svg {
      width: 16px;
      height: 16px;
    }
  }
</style>
